# =============================================================================
# whatsapp-os environment
#
# Copy to .env and fill in. Every variable the codebase reads is listed here.
# The contract is enforced at boot by the Zod schemas in
# packages/core/src/env.ts - a missing or malformed value stops the process
# rather than surfacing as `undefined` at request time.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | test | production
NODE_ENV=development


# -----------------------------------------------------------------------------
# Database  (required — web, worker, Prisma CLI)
# -----------------------------------------------------------------------------
# Four connection strings. Which role each uses is load-bearing.
#
#   POSTGRES_SUPERUSER_URL  superuser       `npm run db:roles` and nothing else
#   DATABASE_URL            whatsapp_owner  migrations and the Prisma CLI
#   DATABASE_URL_APP        app_runtime     every application query
#   DATABASE_URL_ADMIN      app_admin       the platform admin panel only
#
# Postgres exempts a table's OWNER from that table's row-level security
# policies unless FORCE is set, and exempts superusers unconditionally, FORCE
# or not. So the owner is a plain NOSUPERUSER NOBYPASSRLS role: that is what
# makes "the owner sees nothing without a company context" a claim the test
# suite can actually check. The application has its own non-owner role on top,
# and nothing falls back to DATABASE_URL.
#
# All three role passwords are set by `npm run db:roles`, which is the only
# thing that ever uses the superuser credential.

# Cluster superuser. Matches docker-compose.yml. Creating roles and
# transferring table ownership are the only operations that require it.
POSTGRES_SUPERUSER_URL=postgresql://whatsapp:whatsapp@localhost:5432/postgres

# Table owner. Runs migrations. Needs CREATEDB: `prisma migrate dev` provisions
# a shadow database, and the test harness creates whatsapp_os_test.
DATABASE_URL=postgresql://whatsapp_owner:whatsapp_owner@localhost:5432/whatsapp_os?schema=public

# Runtime, owns nothing. Subject to every RLS policy. Required.
DATABASE_URL_APP=postgresql://app_runtime:app_runtime@localhost:5432/whatsapp_os?schema=public

# Platform admin. Reads across companies via an explicit per-table policy —
# NOT via BYPASSRLS, which needs a real superuser to grant and so cannot be
# created on RDS, Supabase or Neon. Optional; only the /admin route needs it.
DATABASE_URL_ADMIN=postgresql://app_admin:app_admin@localhost:5432/whatsapp_os?schema=public

# Maximum pooled connections for the runtime client. Optional, defaults to 10.
# withCompany holds a connection for the duration of its transaction, so this
# is the ceiling on concurrent tenant-scoped operations.
# DATABASE_POOL_MAX=10

# Where `npm test` puts its database. Optional, and normally left unset: the
# test URL is derived from DATABASE_URL by swapping the database name for
# whatsapp_os_test, so it cannot drift when POSTGRES_PORT changes. Set it only
# to point the suite at a different server entirely.
# DATABASE_URL_TEST=


# -----------------------------------------------------------------------------
# Redis / queues  (required — web, worker)
# -----------------------------------------------------------------------------
# Must be a redis:// or rediss:// connection string.
REDIS_URL=redis://localhost:6379

# Namespace for BullMQ keys, so several environments can share one Redis.
# Optional — defaults to "whatsapp-os".
QUEUE_PREFIX=whatsapp-os


# -----------------------------------------------------------------------------
# Encryption  (required — anything reading or writing encrypted columns)
# -----------------------------------------------------------------------------
# 32 raw bytes, base64-encoded. Generate a fresh one with:
#
#     openssl rand -base64 32
#
# or, without openssl:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# The value below is a PLACEHOLDER (32 zero bytes). Replace it before storing
# anything real, and never commit the value you actually use.
#
# ENCRYPTION_KEY is NOT part of the vault keyring below and the two are not
# interchangeable. This one is the HMAC key behind hashIp(), so changing it
# invalidates every stored ip_hash rather than anything decryptable.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# The credential vault keyring: id:base64key pairs, comma-separated.
#
# Several at once, because rotating a key means the old one must still open old
# rows while the new one seals new ones. Ids are [a-z0-9_]{1,16} and must not
# contain a dot — the stored format is v2.<id>.<iv>.<tag>.<ciphertext>.
#
# Rotating — the whole procedure, and it has been run:
#
#   1. add a new key here, KEEP the old one
#   2. point ENCRYPTION_KEY_ACTIVE at it
#      (vault:rotate refuses to start if the active id names a key that is not
#       in this list, because rotating toward a key that does not exist would
#       seal rows nothing can open)
#   3. npm run vault:rotate -- --dry-run    # how many rows would move
#   4. npm run vault:rotate
#   5. npm run vault:status                 # MUST EXIT 0
#   6. only then remove the old key from this list
#   7. npm run vault:status again, still 0
#
# Step 5 is an exit code rather than a judgement call. "Confirm the counts look
# right" is a decision made by a tired person at the end of a rotation, and the
# failure mode is dropping a key a handful of rows still need — unrecoverable.
#
# Single-quote the value: docker compose reads this same file.
ENCRYPTION_KEYS='k1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA='

# Which key in ENCRYPTION_KEYS seals new writes.
ENCRYPTION_KEY_ACTIVE=k1


# -----------------------------------------------------------------------------
# Local service ports  (docker-compose.yml only — not read by the apps)
# -----------------------------------------------------------------------------
# Host ports for the Postgres and Redis containers. 5432 and 6379 are often
# already taken by another project or a local install; change these and the
# matching URLs above if `docker compose up` reports "port is already
# allocated". Optional — default to 5432 and 6379.
POSTGRES_PORT=5432
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# Web  (apps/web)
# -----------------------------------------------------------------------------
# Absolute origin the app is served from. Optional — defaults to
# http://localhost:3000.
APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Worker  (apps/worker)
# -----------------------------------------------------------------------------
# Jobs handled concurrently per worker process. Optional — defaults to 5.
WORKER_CONCURRENCY=5

# debug | info | warn | error. Optional — defaults to info.
LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Platform admin  (apps/web)
# -----------------------------------------------------------------------------
# The /admin panel is a separate account space from tenant sign-in — a separate
# table, a separate cookie, and no role flag anywhere. These seed it.
#
# ADMIN_PASSWORD_HASH is an Argon2id HASH, never the password. Generate one:
#
#     npm run admin:hash
#
# then apply it with `npm run admin:seed`. A plaintext password here would sit
# in your shell history, in `docker inspect` and in the process listing; the
# seed script refuses anything that does not start with $argon2id$.
#
# SINGLE-QUOTE THE HASH. An Argon2 hash is full of $ characters, and Docker
# Compose reads this same file to substitute variables into docker-compose.yml
# — unquoted, it tries to expand $argon2id, $v, $m and the salt, and warns
# about each on every compose command. Single quotes make the value literal for
# both Compose and dotenv.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=''
