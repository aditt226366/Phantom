# =============================================================================
# whatsapp-os environment
#
# Copy to .env and fill in. Every variable the codebase reads is listed here.
# The contract is enforced at boot by the Zod schemas in
# packages/core/src/env.ts - a missing or malformed value stops the process
# rather than surfacing as `undefined` at request time.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
# development | test | production
NODE_ENV=development


# -----------------------------------------------------------------------------
# Database  (required — web, worker, Prisma CLI)
# -----------------------------------------------------------------------------
# Must be a postgres:// or postgresql:// connection string.
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://whatsapp:whatsapp@localhost:5432/whatsapp_os?schema=public

# Where `npm test` puts its database. Optional, and normally left unset: the
# test URL is derived from DATABASE_URL by swapping the database name for
# whatsapp_os_test, so it cannot drift when POSTGRES_PORT changes. Set it only
# to point the suite at a different server entirely.
# DATABASE_URL_TEST=


# -----------------------------------------------------------------------------
# Redis / queues  (required — web, worker)
# -----------------------------------------------------------------------------
# Must be a redis:// or rediss:// connection string.
REDIS_URL=redis://localhost:6379

# Namespace for BullMQ keys, so several environments can share one Redis.
# Optional — defaults to "whatsapp-os".
QUEUE_PREFIX=whatsapp-os


# -----------------------------------------------------------------------------
# Encryption  (required — anything reading or writing encrypted columns)
# -----------------------------------------------------------------------------
# 32 raw bytes, base64-encoded. Generate a fresh one with:
#
#     openssl rand -base64 32
#
# or, without openssl:
#
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# The value below is a PLACEHOLDER (32 zero bytes). Replace it before storing
# anything real, and never commit the value you actually use.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=


# -----------------------------------------------------------------------------
# Local service ports  (docker-compose.yml only — not read by the apps)
# -----------------------------------------------------------------------------
# Host ports for the Postgres and Redis containers. 5432 and 6379 are often
# already taken by another project or a local install; change these and the
# matching URLs above if `docker compose up` reports "port is already
# allocated". Optional — default to 5432 and 6379.
POSTGRES_PORT=5432
REDIS_PORT=6379


# -----------------------------------------------------------------------------
# Web  (apps/web)
# -----------------------------------------------------------------------------
# Absolute origin the app is served from. Optional — defaults to
# http://localhost:3000.
APP_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Worker  (apps/worker)
# -----------------------------------------------------------------------------
# Jobs handled concurrently per worker process. Optional — defaults to 5.
WORKER_CONCURRENCY=5

# debug | info | warn | error. Optional — defaults to info.
LOG_LEVEL=info
