{
  "name": "whatsapp-os",
  "version": "0.1.0",
  "private": true,
  "description": "whatsapp-os — Next.js 16 App Router monorepo (web + worker + db + core)",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:worker": "npm run dev --workspace=worker",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test:setup": "node packages/db/scripts/migrate-test.mjs",
    "db:setup": "npm run migrate:deploy --workspace=@whatsapp-os/db && npm run generate --workspace=@whatsapp-os/db",
    "db:generate": "npm run generate --workspace=@whatsapp-os/db",
    "db:migrate": "npm run migrate --workspace=@whatsapp-os/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@whatsapp-os/db",
    "db:push": "npm run push --workspace=@whatsapp-os/db",
    "db:studio": "npm run studio --workspace=@whatsapp-os/db",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "pg": "^8.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
