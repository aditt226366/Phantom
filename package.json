{
  "name": "whatsapp-os",
  "version": "0.1.0",
  "private": true,
  "description": "whatsapp-os \u2014 Next.js 16 App Router monorepo (web + worker + db + core)",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:worker": "npm run dev --workspace=worker",
    "tunnel": "node scripts/tunnel.mjs",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "build": "npm run build --workspace=web",
    "start": "npm run start --workspace=web",
    "lint": "npm run lint --workspace=web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:gate": "node scripts/test-floor.mjs",
    "break-once": "node scripts/break-once.mjs",
    "test:watch": "vitest",
    "test:visual": "npm run test:visual --workspace=web",
    "test:visual:update": "npm run test:visual:update --workspace=web",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test:gate && npm run test:visual",
    "verify:no-visual": "npm run typecheck && npm run lint && npm run build && npm run test:gate",
    "db:test:setup": "npm run test:setup --workspace=@whatsapp-os/db",
    "db:setup": "npm run roles --workspace=@whatsapp-os/db && npm run migrate:deploy --workspace=@whatsapp-os/db && npm run generate --workspace=@whatsapp-os/db",
    "db:generate": "npm run generate --workspace=@whatsapp-os/db",
    "db:migrate": "npm run migrate --workspace=@whatsapp-os/db",
    "db:migrate:deploy": "npm run migrate:deploy --workspace=@whatsapp-os/db",
    "db:roles": "npm run roles --workspace=@whatsapp-os/db",
    "db:nuke": "npm run nuke --workspace=@whatsapp-os/db --",
    "db:verify": "node scripts/db-verify.mjs",
    "db:explain:dashboard": "npm run explain:dashboard --workspace=@whatsapp-os/db",
    "admin:hash": "npm run admin:hash --workspace=web",
    "admin:seed": "npm run admin:seed --workspace=web",
    "db:studio": "npm run studio --workspace=@whatsapp-os/db",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "vault:status": "npm run vault:status --workspace=web --",
    "vault:rotate": "npm run vault:rotate --workspace=web --",
    "dashboard:schedule": "npm run dashboard:schedule --workspace=web --"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/pg": "^8.21.0",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
