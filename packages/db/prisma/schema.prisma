// whatsapp-os database schema.
//
// Scope note: this is foundation only - a company, and users belonging to a
// company. No product models yet. What matters here is the multi-tenant shape:
// every tenant-owned table carries a `company_id` column, an index leading with
// it, and a compound unique that includes it. The withCompany client extension
// in src/with-company.ts relies on that convention.
//
// Column naming: snake_case throughout, via @map. Prisma quotes unmapped
// camelCase identifiers ("createdAt"), which means every hand-written migration
// and RLS policy has to quote them too. The tenancy rules in CLAUDE.md are
// written in snake_case (`company_id`), so the whole schema follows.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A customer workspace. The root of every tenant-scoped query.
/// Not itself company-scoped - see COMPANY_SCOPED_MODELS in with-company.ts.
model Company {
  id        String   @id @default(cuid())
  /// URL-safe handle, unique across the installation.
  slug      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("companies")
}

/// A person inside a company.
///
/// Email is unique *per company*, not globally: the same human may belong to
/// two workspaces. That is why the unique constraint is compound.
model User {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  email     String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
  @@map("users")
}
