// whatsapp-os database schema.
//
// Two kinds of table live here, and the difference is a security boundary:
//
//   Tenant-owned  company_id NOT NULL, a composite index leading with it, and
//                 RLS policies. Everything a company can see.
//   Global        deliberately outside tenancy, each for a stated reason.
//                 Listed in GLOBAL_TABLES in tests/schema-invariants.test.ts,
//                 which fails if a table is neither one nor the other.
//
// Column naming: snake_case throughout, via @map. Prisma quotes unmapped
// camelCase identifiers ("createdAt"), which means every hand-written migration
// and RLS policy has to quote them too.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MEMBER

  @@map("user_role")
}

enum AuditAction {
  SIGNUP
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGED
  EMAIL_VERIFIED
  /// The breach check could not be reached and the password was accepted
  /// without it. Recorded so the gap is visible rather than silent.
  HIBP_UNAVAILABLE
  /// A deferred breach check completed at sign-in and found nothing.
  HIBP_CHECKED
  /// A deferred breach check completed and found the password in a breach.
  PASSWORD_BREACHED
  /// A reset link was requested. Written whether or not the address exists is
  /// impossible — there is no company to attach it to when it does not — so
  /// this only ever appears for a real account.
  PASSWORD_RESET_REQUESTED

  @@map("audit_action")
}

/// What a company pays for. Drives the plan distribution on the admin
/// overview, and nothing else yet - entitlements are Phase 6.
enum Plan {
  STARTER
  PRO
  ENTERPRISE

  @@map("plan")
}

/// A customer workspace. The root of every tenant-scoped query.
/// Not itself company-scoped - see COMPANY_SCOPED_MODELS in with-company.ts.
model Company {
  id String @id @default(cuid())

  /// URL-safe handle, unique across the installation.
  ///
  /// Derived from the name at signup, never typed by the user. Two companies
  /// may legitimately share a name, so a collision appends a short suffix
  /// rather than rejecting the signup - "that company name is taken" would be
  /// a lie about someone else's data. See app_available_slug() and
  /// src/company.ts.
  slug String @unique

  name String
  plan Plan @default(STARTER)

  /// Set to suspend the workspace. Null means active.
  ///
  /// Enforced inside app_resolve_company(), not here and not in a middleware:
  /// every entry point - sign-in, an already-issued session, a verification or
  /// reset link - resolves a company through that function, so one clause
  /// covers all of them and no later route can forget it. The app-level check
  /// in requireSession() exists to render a message, not to be the boundary.
  deactivatedAt DateTime? @db.Timestamptz(3) @map("deactivated_at")

  /// Milliseconds between two sends of one broadcast. Admin-configurable.
  ///
  /// A tenant-level setting rather than a constant, because the right pace
  /// depends on a number's throughput level and on how much a business is
  /// willing to have its quality rating watched. 800ms is roughly 75 messages
  /// a minute, which is slow enough that a bad template shows up in the
  /// quality rating before the whole list has received it.
  ///
  /// It is pacing, NOT the limit. The messaging tier caps unique recipients
  /// per rolling 24 hours and is the real ceiling - see broadcastTierHeadroom.
  broadcastGapMs Int @default(800) @map("broadcast_gap_ms")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  users                  User[]
  sessions               Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  auditLogs              AuditLog[]
  integrations           Integration[]
  integrationSecrets     IntegrationSecret[]
  integrationVerifications IntegrationVerification[]
  usageEvents            UsageEvent[]
  whatsappNumbers        WhatsAppNumber[]
  contacts               Contact[]
  conversations          Conversation[]
  messages               Message[]
  whatsappMedia          WhatsAppMedia[]
  webhookEvents          WhatsAppWebhookEvent[]
  unroutableWebhooks     UnroutableWebhook[]
  whatsappTemplates      WhatsAppTemplate[]
  templateEdits          WhatsAppTemplateEdit[]
  kycDocuments           KycDocument[]
  broadcasts             Broadcast[]
  broadcastRecipients    BroadcastRecipient[]
  leadSources            LeadSource[]
  leadSourceRows         LeadSourceRow[]
  flows                  Flow[]
  flowVersions           FlowVersion[]
  flowRuns               FlowRun[]
  flowRunSteps           FlowRunStep[]
  knowledgeBases         KnowledgeBase[]
  kbDocuments            KbDocument[]
  kbChunks               KbChunk[]
  kbChunkSources         KbChunkSource[]
  conversationCharges    WhatsAppConversationCharge[]
  verseCampaigns         VerseCampaign[]
  metaAdAccounts         MetaAdAccount[]
  metaCampaigns          MetaCampaign[]
  metaAdInsights         MetaAdInsight[]
  metaAdReferrals        MetaAdReferral[]
  verseCampaignRecipients VerseCampaignRecipient[]
  dashboardRollup        DashboardRollup?

  @@map("companies")
}

/// A person inside a company.
model User {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  fullName String @map("full_name")

  /// Globally unique, not per-company.
  ///
  /// Password reset is keyed on the email address with no company context, so
  /// two companies holding the same address makes the lookup ambiguous - and
  /// there is no clean migration out of that once rows exist.
  email String @unique

  emailVerifiedAt DateTime? @db.Timestamptz(3) @map("email_verified_at")

  /// Globally unique, and the reason app_resolve_company() exists: sign-in is
  /// username + password with no company selector, so the username has to
  /// resolve to exactly one account before any company context is available.
  /// Stored lowercase; the ^[a-z0-9_.]{3,32}$ rule makes uppercase invalid
  /// input rather than a different-case duplicate, so no citext is needed.
  username String @unique

  passwordHash      String   @map("password_hash")
  phoneE164         String   @map("phone_e164")
  role              UserRole @default(MEMBER)
  passwordChangedAt DateTime @db.Timestamptz(3) @default(now()) @map("password_changed_at")
  lastLoginAt       DateTime? @db.Timestamptz(3) @map("last_login_at")

  /// When the breach check last actually ran for this password.
  ///
  /// Null means it has never completed — either signup failed open because
  /// HaveIBeenPwned was unreachable, or the password has been changed since.
  /// The next successful sign-in retries it, which is the only moment the
  /// plaintext exists again.
  hibpCheckedAt DateTime? @db.Timestamptz(3) @map("hibp_checked_at")

  /// Set when the breach check found this password in a known breach.
  ///
  /// Advisory, not a block: the user can still sign in. Locking someone out of
  /// an account they can demonstrably authenticate to is worse than the risk,
  /// and leaves them no way to fix it.
  passwordBreachedAt DateTime? @db.Timestamptz(3) @map("password_breached_at")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  conversationsAssigned   Conversation[]           @relation("ConversationsAssigned")
  templatesCreated        WhatsAppTemplate[]       @relation("TemplatesCreated")
  templateEdits           WhatsAppTemplateEdit[]   @relation("TemplateEdits")
  messagesSent            Message[]                @relation("MessagesSent")
  broadcastsCreated       Broadcast[]              @relation("BroadcastsCreated")
  leadSourcesCreated      LeadSource[]             @relation("LeadSourcesCreated")
  flowsCreated            Flow[]                   @relation("FlowsCreated")
  flowVersionsCreated     FlowVersion[]            @relation("FlowVersionsCreated")
  flowVersionsPublished   FlowVersion[]            @relation("FlowVersionsPublished")
  metaCampaignsPublished  MetaCampaign[]           @relation("MetaCampaignsPublished")

  @@index([companyId, createdAt])
  @@map("users")
}

/// A signed-in browser. Server-side, so revocation is immediate.
model Session {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  userId    String @map("user_id")

  /// SHA-256 of the cookie value. The raw token is never stored, so a database
  /// leak does not hand over live sessions.
  tokenHash String @unique @map("token_hash")

  /// Per-session CSRF secret. Binding the token to the session makes it immune
  /// to a cookie injected from a sibling subdomain.
  csrfSecret String @map("csrf_secret")

  /// Hashed, not raw: an IP is personal data and this is only ever compared.
  ipHash    String?  @map("ip_hash")
  userAgent String?  @map("user_agent")

  createdAt  DateTime @db.Timestamptz(3)  @default(now()) @map("created_at")
  lastSeenAt DateTime @db.Timestamptz(3)  @default(now()) @map("last_seen_at")
  expiresAt  DateTime @db.Timestamptz(3)  @map("expires_at")
  revokedAt  DateTime? @db.Timestamptz(3) @map("revoked_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  /// For the expiry sweeper, which runs without a company context.
  @@index([expiresAt])
  @@map("sessions")
}

/// A single-use email verification link.
model EmailVerificationToken {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  userId    String @map("user_id")

  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime @db.Timestamptz(3)  @map("expires_at")
  consumedAt DateTime? @db.Timestamptz(3) @map("consumed_at")
  createdAt  DateTime @db.Timestamptz(3)  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  @@map("email_verification_tokens")
}

/// A single-use password reset link.
///
/// One hour, not the verification token's twenty-four: this one is a full
/// account takeover if it leaks, and it is requested by someone who is at their
/// keyboard right now.
model PasswordResetToken {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  userId    String @map("user_id")

  tokenHash String @unique @map("token_hash")

  expiresAt  DateTime @db.Timestamptz(3)  @map("expires_at")
  consumedAt DateTime? @db.Timestamptz(3) @map("consumed_at")
  createdAt  DateTime @db.Timestamptz(3)  @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId])
  @@map("password_reset_tokens")
}

/// Security-relevant events, per company.
model AuditLog {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  /// Nullable: the actor may have been deleted, and some events have no actor.
  userId String? @map("user_id")

  action    AuditAction
  ip        String?
  userAgent String?     @map("user_agent")
  metadata  Json?
  createdAt DateTime @db.Timestamptz(3)    @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@map("audit_log")
}

/// The third-party systems a company connects. See INTEGRATION_KEYS in
/// @whatsapp-os/core for the credential each one requires.
enum IntegrationProvider {
  GOOGLE_SHEETS
  WHATSAPP_CLOUD
  META_ADS

  @@map("integration_provider")
}

/// Whether the credentials last verified against the provider.
///
/// Two states, not three. "Verifying" is a property of a request in flight,
/// not of a row, and storing it means every crashed job leaves a company stuck
/// in it forever.
enum IntegrationStatus {
  CONNECTED
  NOT_CONNECTED

  @@map("integration_status")
}

/// A company's connection to one provider.
///
/// The parent row: what the connection is and whether it currently works. The
/// credentials themselves live in IntegrationSecret, one row per key, so that
/// re-encrypting under a new key touches one narrow table and so that no query
/// selecting an integration drags ciphertext along with it by accident.
model Integration {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  provider IntegrationProvider
  /// Operator-facing name. Distinguishes several of the same provider once the
  /// unique constraint below is relaxed.
  label    String
  status   IntegrationStatus   @default(NOT_CONNECTED)

  /// The opaque path segment Meta posts to: /api/webhooks/whatsapp/{key}.
  ///
  /// Not a company id and not this row's id. Meta stores this URL somewhere we
  /// do not control and renders it in a UI customers screenshot, so it must
  /// carry no internal identifier - and it must rotate without touching a
  /// credential, which anything derived from an id could not.
  ///
  /// Globally unique, because the lookup happens before any company context
  /// exists. app_resolver holds a column-level SELECT on exactly this column
  /// and company_id; see the resolver migration.
  ///
  /// The default is a database expression rather than application code so that
  /// no row can exist without one, including rows written by a migration or by
  /// a future code path that has not thought about webhooks.
  ///
  /// Rotation, stated because "it rotates without touching a credential" is
  /// half the argument for having this column at all:
  ///
  ///   It is a plain UPDATE of this one value, in the same 32-hex shape, and
  ///   nothing else moves - no credential is re-encrypted, because none of the
  ///   AAD components change. That is the property the opaque key buys.
  ///
  ///   It is NOT free to the tenant. The old URL stops resolving the instant
  ///   the UPDATE commits, and inbound messages are dropped until they paste
  ///   the new one into Meta - during which Meta is accumulating failures
  ///   toward disabling the subscription. So it is a deliberate act with a
  ///   warning attached, not a background hygiene job.
  ///
  ///   The control therefore lives with the page that displays the URL -
  ///   Configuration > Numbers - rather than anywhere it could be triggered
  ///   without the person seeing what they have to do next.
  /// The expression is spelled the way Postgres normalises it, not the way it
  /// was written in the migration. pg_get_expr() re-prints a default with its
  /// own parenthesisation and explicit casts, so the readable form drifts on
  /// every check - the same trap as an index name that does not match its
  /// @map'ed column.
  webhookKey String @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("webhook_key")

  lastVerifiedAt DateTime? @db.Timestamptz(3) @map("last_verified_at")
  /// The last failure, already scrubbed. Never contains a credential - see
  /// redactKeys/scrubValues in @whatsapp-os/core.
  lastError      String?   @map("last_error")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company       Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  secrets         IntegrationSecret[]
  verifications   IntegrationVerification[]
  whatsappNumbers WhatsAppNumber[]
  webhookEvents   WhatsAppWebhookEvent[]
  templates       WhatsAppTemplate[]

  /// One per provider per company, for now. This relaxes in Phase 4/6, when a
  /// company gets several numbers and several sheet bindings - which is why
  /// `label` already exists and nothing keys off the provider alone.
  metaAdAccounts  MetaAdAccount[]
  @@unique([companyId, provider])
  @@map("integrations")
}

/// One credential value, encrypted at rest.
///
/// company_id is carried here as well as on the parent, rather than being
/// reached through it. RLS evaluates per table: a policy that had to join
/// integrations to find the company would be a policy that can be got wrong,
/// and the composite index this requires is the one the vault reads by anyway.
///
/// ---------------------------------------------------------------------------
/// Three columns are load-bearing beyond their values
/// ---------------------------------------------------------------------------
///
/// Each ciphertext is bound to where it lives. AES-GCM takes additional
/// authenticated data, and the vault passes
/// `${company_id}:${integration_id}:${key}` - derived from the row at call
/// time, never stored. A ciphertext lifted out of one company's row and written
/// into another's fails to decrypt instead of quietly working, which is the
/// same guarantee RLS gives one table lower down.
///
/// The cost is that those three values are effectively immutable:
///
///   company_id      a secret cannot be moved between companies. Correct, and
///                   nothing should ever want to.
///   integration_id  re-pointing a secret at a different integration row is a
///                   decrypt-and-re-encrypt, not an UPDATE. This matters when
///                   the unique on (company_id, provider) relaxes in Phase 4/6
///                   and secrets start moving between integration rows.
///   key             renaming a credential in INTEGRATION_KEYS is a
///                   decrypt-and-re-encrypt too, not a string change in
///                   packages/core/src/integrations.ts. Meta has renamed
///                   credentials before, so this is the one likely to be
///                   discovered by breaking it.
///
/// In all three cases the symptom is EncryptionError on every read of the
/// affected rows, not silent wrong data.
model IntegrationSecret {
  id            String @id @default(cuid())
  companyId     String @map("company_id")
  integrationId String @map("integration_id")

  /// The provider's own name for it, e.g. WHATSAPP_ACCESS_TOKEN.
  key        String
  /// v2.<keyid>.<iv>.<tag>.<ciphertext> - see @whatsapp-os/core/encryption.
  ciphertext String
  /// Which keyring key sealed this row. What makes rotation resumable: the
  /// re-encrypt job selects on key_id <> active, so re-running it is a no-op.
  keyId      String @map("key_id")
  /// Last four characters of the plaintext, stored in the clear so the panel
  /// has something to render. The only part of a secret that ever leaves here.
  ///
  /// Null for anything shorter than MIN_LENGTH_FOR_LAST4: showing the last
  /// four characters of a six-character value discloses most of it, and the
  /// hint exists to confirm which credential is loaded, not to rebuild it.
  last4      String?

  /// When the provider says this credential stops working. Null for the
  /// credentials that do not expire at all - a private key, a verify token,
  /// an app secret - which is most of them, and where a far-future date
  /// would be an expiry the provider never issued.
  ///
  /// A3 requires this for Meta Ads: the tenant now does their own Meta-side
  /// work to produce a token, so its lifetime is an operational fact they
  /// have to act on rather than our internal detail. Without it the failure
  /// is a campaign that silently stops working and an operator with no
  /// reason for it.
  expiresAt DateTime? @db.Timestamptz(3) @map("expires_at")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, key])
  @@index([companyId, integrationId])
  @@map("integration_secrets")
}

/// One verification attempt against a provider.
///
/// An operational log, deliberately not admin_audit_log. That records what an
/// operator did; this records what a third party answered, is written by the
/// worker with no admin in the request at all, and is a company's own data.
model IntegrationVerification {
  id            String @id @default(cuid())
  companyId     String @map("company_id")
  integrationId String @map("integration_id")

  ok         Boolean
  /// The provider's HTTP status, when there was a response to have one.
  statusCode Int?    @map("status_code")
  /// Scrubbed before it is written. Meta echoes request parameters back in
  /// some error bodies, so this passes through scrubValues on the way in.
  error      String?

  /// How the failure was classified: auth and config demote the badge,
  /// transient does not. Null on success.
  failureKind String? @map("failure_kind")

  /// Provider identifiers worth keeping - for Meta, code, error_subcode and
  /// fbtrace_id. Support asks for fbtrace_id first, it exists only in the
  /// response that failed, and it is worth nothing if it was never stored.
  details Json?

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt(sort: Desc)])
  @@map("integration_verifications")
}

/// The quality rating Meta assigns from how recipients react.
///
/// Drops to RED before Meta restricts a number, so it is the earliest warning a
/// customer gets that their messaging is about to stop working.
enum WhatsAppQualityRating {
  GREEN
  YELLOW
  RED
  UNKNOWN

  @@map("whatsapp_quality_rating")
}

/// One phone number under a company's WhatsApp Business Account.
///
/// Meta's model is one WABA to many numbers, and this mirrors it rather than
/// relaxing Integration's unique on (company_id, provider). Relaxing that would
/// move secrets between integration rows, and integration_id is an AAD
/// component - so that is a decrypt-and-re-encrypt of every credential, not an
/// UPDATE. See the note on IntegrationSecret above, which names this phase.
///
/// company_id is carried here and not reached through integration_id, for the
/// same reason IntegrationSecret carries it: RLS evaluates per table, a policy
/// that had to join integrations to find the company is a policy that can be
/// got wrong, and schema-invariants would fail the table outright.
///
/// Everything Meta tells us about a number is a cache. The refresh job owns it;
/// nothing here is typed by a person.
model WhatsAppNumber {
  id            String @id @default(cuid())
  companyId     String @map("company_id")
  integrationId String @map("integration_id")

  /// Meta's id for this number. Every Graph call and every webhook payload
  /// names it by this, never by the display number.
  phoneNumberId String @map("phone_number_id")

  /// E.164 as Meta formats it, for display only. Never a lookup key: Meta has
  /// changed its spacing, and matching on it would split one number in two.
  displayNumber String  @map("display_number")
  /// The business name shown to recipients, once Meta has approved it.
  verifiedName  String? @map("verified_name")

  qualityRating WhatsAppQualityRating @default(UNKNOWN) @map("quality_rating")

  /// Meta's own strings - CONNECTED, PENDING, FLAGGED, RESTRICTED, and at least
  /// BANNED, MIGRATED, RATE_LIMITED and UNVERIFIED that we do not model. Text
  /// and not an enum, for the same reason messaging_tier is: the vocabulary is
  /// Meta's, they add to it, and an unrecognised value must render as itself
  /// rather than be flattened into UNKNOWN on the way in.
  ///
  /// UNKNOWN remains the default and a real value, meaning "Meta has told us
  /// nothing" - distinct from metadata_refreshed_at being null, which means we
  /// have never asked. sendPolicy refuses to send from either that or anything
  /// it does not recognise, which is the fail-closed half of 20260816100000.
  status        String                @default("UNKNOWN")

  /// Meta's own strings, e.g. TIER_1K. Text and not enums, deliberately: the
  /// sets have changed twice already, and an unrecognised tier must render as
  /// itself at 3am rather than reject the refresh that carried it.
  messagingTier   String? @map("messaging_tier")
  throughputLevel String? @map("throughput_level")

  /// When this row last agreed with Meta. Everything above it is a cache, and a
  /// cache with no age is a claim nobody can check. Null means never fetched.
  ///
  /// Read by the numbers page to say how stale the data is. Never a trigger to
  /// go and fetch: a Graph call on page load is the thing this cache exists to
  /// prevent, and staleness shown honestly beats a dashboard that calls Meta
  /// every time somebody opens it.
  metadataRefreshedAt DateTime? @db.Timestamptz(3) @map("metadata_refreshed_at")

  /// When Meta first stopped returning this number, or null if it still does.
  ///
  /// Set rather than deleting the row: a number absent because somebody removed
  /// it in Business Manager and one absent because a single API call came back
  /// short look identical from here, and only one is real. Untouched by later
  /// refreshes that also miss it, so the age of the absence is readable, and
  /// cleared the moment Meta returns it again.
  missingSince  DateTime? @db.Timestamptz(3) @map("missing_since")
  /// Why, as a machine code - the shape skipped_reason uses elsewhere.
  missingReason String?   @map("missing_reason")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integration   Integration    @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  broadcasts    Broadcast[]
  leadSources   LeadSource[]

  /// The natural key. Meta's phone_number_id is globally unique, but scoping it
  /// per company keeps the uniqueness a tenant fact rather than a global one -
  /// two companies must never collide, and neither must learn of the other by
  /// failing to insert.
  verseCampaigns VerseCampaign[]

  metaAdAccounts MetaAdAccount[]
  @@unique([companyId, phoneNumberId])
  @@index([companyId, createdAt(sort: Desc)])
  @@map("whatsapp_numbers")
}

/// Which way a message travelled. Ours to define, so an enum.
enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

/// The delivery ladder.
///
/// Ours, not Meta's, which is what makes an enum safe here: Meta's status
/// strings are mapped into this by the webhook parser, and one it does not
/// recognise is ignored rather than written. PENDING has no Meta equivalent at
/// all - it means accepted by us and not yet handed over.
///
/// The order of the members is documentation. The authority is the rank in
/// @whatsapp-os/core, which the worker consults before every write, and FAILED
/// sits above SENT there deliberately - Meta emits `failed` after `sent` for
/// downstream rejections, so a ladder that ranked it below would drop the
/// failure and leave a message reading as on-its-way for ever.
enum MessageStatus {
  PENDING
  /// Handed to Meta, and Meta never answered. Not FAILED - we do not know it
  /// failed; not SENT - we do not know it sent; and deliberately not PENDING,
  /// because anything that claims work by status would pick it up and send it
  /// again. There is no wamid, so no callback can ever resolve it: only a
  /// person can, by looking at WhatsApp. See 20260816120000.
  UNCONFIRMED
  /// Meta answered 200 and gave us a wamid, then held the message for quality
  /// assessment instead of sending it. Written from the send response, never
  /// from a status callback - Meta reports it on the POST and nowhere else.
  HELD
  SENT
  FAILED
  DELIVERED
  READ

  @@map("message_status")
}

/// How a conversation started. Our categorisation, so an enum.
enum ConversationSource {
  INBOUND
  CAMPAIGN
  ADS_CLICK_TO_WHATSAPP
  MANUAL

  @@map("conversation_source")
}

/// Who refused to deliver a message.
///
/// Meta's codes and our own policy's reasons are different namespaces, and
/// conflating them means a support reply quoting a Graph code Meta never
/// issued. Only META rows carry error_code.
enum MessageFailureSource {
  META
  POLICY

  @@map("message_failure_source")
}

/// A WhatsApp user who has messaged this company, or been messaged by it.
model Contact {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  /// Meta's wa_id: the only stable identity a WhatsApp user has, and the key
  /// every webhook arrives under.
  ///
  /// Matched on rather than phone_e164, because the two are not always the
  /// same number. Brazil and Mexico have historically differed by a digit
  /// between the number that messages and the wa_id it arrives as, so matching
  /// on our normalised form would split one person into two contacts and split
  /// their 24-hour window with them.
  waId String @map("wa_id")

  /// E.164 from parsePhone, for display and for Phase 5's audience building.
  /// Null when wa_id does not parse as a number we recognise - which is not a
  /// reason to drop the message.
  phoneE164 String? @map("phone_e164")

  /// The name the contact set on their own profile. Meta sends it on the first
  /// inbound message of a window and not reliably afterwards, so it is only
  /// ever written when present and never overwritten with null.
  profileName String? @map("profile_name")
  /// A name somebody here typed. Wins over profileName when set.
  displayName String? @map("display_name")

  /// Set when the contact opts out. STOP handling is Phase 12; the column is
  /// here now because Phase 5's send queue filters on it, and adding it later
  /// is a backfill on what will by then be the largest table in the schema.
  optedOutAt DateTime? @db.Timestamptz(3) @map("opted_out_at")

  /// Set when Meta reports 131026 - this number cannot receive WhatsApp at all.
  ///
  /// Distinct from opting out, and the difference matters to a person reading
  /// the report: an opt-out is the customer's decision and must be honoured
  /// for ever, while this is a fact about the handset. Both exclude the
  /// contact from future broadcasts; only one of them is a choice.
  undeliverableAt DateTime? @db.Timestamptz(3) @map("undeliverable_at")

  /// How this contact first reached us.
  ///
  /// Shares conversation_source rather than declaring its own enum: a thread
  /// and the person in it arrive the same way, and a second list could only
  /// disagree with the first - in the direction where the dashboard's
  /// lead-source card counts one thing and a report counts another.
  ///
  /// Null is not INBOUND. Every contact predating Phase 10 has null because
  /// nothing recorded this, and defaulting them to INBOUND would tell a
  /// tenant that months of contacts arrived organically when nobody asked.
  source ConversationSource?

  /// How warm this lead is, as a flow's action node last set it.
  ///
  /// -----------------------------------------------------------------------
  /// The column that turns a pending dashboard card into a real one
  /// -----------------------------------------------------------------------
  ///
  /// "Lead temperature" has been an honest empty state since Phase 7, saying
  /// the scoring did not exist. It does now, and it is deterministic: a flow
  /// author draws "this answer makes them hot", so the score is a rule
  /// somebody wrote rather than a model's opinion. That is a different and
  /// smaller claim than the one the pending card described, and the copy has
  /// to say so - which is why replacing that card is part of this phase
  /// rather than a later tidy-up.
  ///
  /// Null means nothing has scored them, and is distinct from COLD. A report
  /// counting unscored contacts as cold would tell a business its whole
  /// contact book was uninterested.
  leadScore LeadScore? @map("lead_score")
  /// When, and by which run. Both, because "scored six months ago" is a
  /// different fact from "scored this morning" and the card says which.
  leadScoreAt     DateTime? @db.Timestamptz(3) @map("lead_score_at")
  leadScoreRunId  String?   @map("lead_score_run_id")

  /// Labels a flow's action node attached. Free text the tenant chose.
  ///
  /// An array rather than a join table, because nothing counts them across
  /// contacts and nothing renames one. A tag is read only with the contact
  /// that carries it, which is the case an array is for.
  tags String[] @default([])

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  verseCampaignRecipients VerseCampaignRecipient[]
  flowRuns      FlowRun[]

  metaAdReferrals MetaAdReferral[]
  @@unique([companyId, waId])
  @@index([companyId, createdAt(sort: Desc)])
  /// The dashboard's lead-temperature card, grouped by score.
  @@index([companyId, leadScore])
  /// Phase 5 excludes opted-out contacts from every campaign. Composite and
  /// company-first so that exclusion is a seek and not a scan of the whole
  /// contact book.
  @@index([companyId, optedOutAt])
  /// The dashboard's lead-source card, grouped by where contacts came from.
  @@index([companyId, source], map: "contacts_company_id_source_idx")
  @@map("contacts")
}

/// One contact, on one of the company's numbers.
model Conversation {
  id               String @id @default(cuid())
  companyId        String @map("company_id")
  contactId        String @map("contact_id")
  whatsappNumberId String @map("whatsapp_number_id")

  source ConversationSource @default(INBOUND)

  /// When the customer last wrote. The fact the window derives from.
  lastInboundAt DateTime? @db.Timestamptz(3) @map("last_inbound_at")
  /// When anything last happened, either direction. What the list sorts on.
  lastMessageAt DateTime? @db.Timestamptz(3) @map("last_message_at")
  /// Denormalised so the list renders without touching messages at all.
  lastMessagePreview String? @map("last_message_preview")

  /// When free-form messaging stops being allowed.
  ///
  /// Stored rather than derived from the newest inbound message, for three
  /// reasons in order of weight: canSend reads one row on the send path, in the
  /// worker, immediately before a Graph call; the inbox filters and sorts on
  /// it, and a derived value cannot be indexed; and the rule is not always
  /// last_inbound_at + 24h - a free-entry-point conversation gets 72h, and Meta
  /// has moved these boundaries before. Storing it puts the rule in one writer
  /// instead of every reader.
  ///
  /// Advanced with GREATEST(), never assigned. Two inbound messages delivered
  /// out of order - which Meta does - would otherwise move it backwards and
  /// close the composer while the window is genuinely open.
  windowExpiresAt DateTime? @db.Timestamptz(3) @map("window_expires_at")

  unreadCount Int @default(0) @map("unread_count")

  /// When somebody decided a person is needed here. Null for almost every row.
  ///
  /// -----------------------------------------------------------------------
  /// Explicit, because it stopped having one source
  /// -----------------------------------------------------------------------
  ///
  /// Phase 5 derived this as `assigned_user_id IS NULL AND unread_count > 0`,
  /// and that was correct while a customer writing in was the only way a
  /// thread came to need somebody. A flow's handoff node is a PROACTIVE claim
  /// - the automation has decided it cannot finish - which is true whether or
  /// not anybody has read the thread and whether or not a reply is owed.
  ///
  /// The handoff originally faked the derivation by incrementing unread_count,
  /// which lies about what that column means and, worse, is undone by
  /// markConversationRead: opening the thread to see why a person was wanted
  /// destroyed the only record that one was.
  ///
  /// Three writers now - an unread inbound, a handoff node, an action node's
  /// notify - and Verse's escalation is the fourth. Reading the flag is not
  /// the same act as clearing it.
  /// Who is currently speaking for the business in this thread.
  ///
  /// -----------------------------------------------------------------------
  /// One column, so "at most one" is unrepresentable rather than kept
  /// -----------------------------------------------------------------------
  ///
  /// Phase 8 shipped the two-writer bug and its fix: a flow run standing in a
  /// thread while an operator types into the same thread is a conversation
  /// with two authors, neither aware of the other, and only the customer able
  /// to see both. That was solved for TWO writers by having the inbox hand off
  /// any live run.
  ///
  /// There are three now - an operator, a flow run, and Verse - and three is
  /// where "whoever wrote last wins" stops being survivable. The losing writer
  /// is not merely overwritten; it CARRIES ON, on its own schedule, into a
  /// conversation somebody else is now having.
  ///
  /// A single column is the whole mechanism: at most one driver is not a rule
  /// anybody enforces, it is a thing this type cannot express the negation of.
  ///
  /// NOBODY is a real member rather than NULL, so the most-read column in the
  /// inbox does not put three-valued logic into every predicate.
  driver      ConversationDriver @default(NOBODY)
  /// Since when. An instant rather than a boolean for the reason
  /// needs_human_at is one: "an operator has held this for forty minutes" is a
  /// fact somebody acts on, and a boolean cannot say it. Tied to the driver by
  /// a CHECK.
  driverSince DateTime?          @db.Timestamptz(3) @map("driver_since")
  /// Which run or campaign, so the inbox can say "Verse (Diwali offers)".
  ///
  /// Deliberately a bare id and NOT a foreign key: it points into two
  /// different tables depending on the driver, and a thread must not become
  /// unreadable because a campaign was archived.
  driverRef   String?            @map("driver_ref")

  needsHumanAt     DateTime? @db.Timestamptz(3) @map("needs_human_at")
  /// Why, in words the queue can show. Set and cleared with the instant above,
  /// by CHECK constraint rather than by convention.
  needsHumanReason String?   @map("needs_human_reason")

  /// Null means nobody has picked it up.
  assignedUserId String?   @map("assigned_user_id")
  assignedAt     DateTime? @db.Timestamptz(3) @map("assigned_at")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  whatsappNumber WhatsAppNumber @relation(fields: [whatsappNumberId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade, and deliberately unlike every other relation in this
  /// schema: deleting an employee must not delete the conversations they
  /// handled. The thread is the company's record of what a customer was told.
  assignedUser   User?          @relation("ConversationsAssigned", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages       Message[]
  flowRuns       FlowRun[]
  verseCampaignRecipients VerseCampaignRecipient[]

  /// One thread per contact per number, and the conflict target the inbound
  /// upsert needs. Without it two deliveries for the same contact arriving
  /// together both find no conversation and both insert, and the customer ends
  /// up with two half-threads whose windows disagree.
  metaAdReferrals MetaAdReferral[]
  @@unique([companyId, contactId, whatsappNumberId])
  /// The inbox list.
  @@index([companyId, lastMessageAt(sort: Desc)])
  /// canSend, and Phase 7's "windows closing within the hour".
  @@index([companyId, windowExpiresAt])
  @@index([companyId, assignedUserId])
  /// The needs-a-person queue, and the dashboard card above it.
  @@index([companyId, needsHumanAt])
  /// "Which threads is Verse holding", for the dashboard card and the
  /// campaign detail page.
  @@index([companyId, driver])
  @@map("conversations")
}

/// One message, in either direction.
model Message {
  id             String @id @default(cuid())
  companyId      String @map("company_id")
  conversationId String @map("conversation_id")

  direction MessageDirection
  status    MessageStatus    @default(PENDING)

  /// Meta's type string, stored as text and never an enum.
  ///
  /// The vocabulary is Meta's, not ours - text, image, document, audio, video,
  /// sticker, location, contacts, interactive, button, order, system, reaction
  /// - and they add to it without notice. An enum would turn "Meta shipped a
  /// new message type" into a failed write on an inbound webhook, which is the
  /// worst place in the system to fail: no user is watching, the delivery
  /// retries, and the customer's message is lost.
  ///
  /// An unrecognised type stores as itself and renders in the thread as an
  /// unsupported-type placeholder, so the gap is visible and the row survives.
  type String

  /// Meta's message id. Null on an outbound message until Meta answers, which
  /// is why the unique below tolerates it: Postgres treats NULLs as distinct,
  /// so many pending sends coexist and every real wamid is still claimed once.
  wamid String?

  /// The rendered text. Null for a media message with no caption.
  body String?

  /// The template as sent, in the same component shape the builder previews and
  /// the Graph call carries. Stored on the message rather than only referenced,
  /// because a template edited or deleted later must not rewrite history.
  templatePayload Json? @map("template_payload")

  /// The interactive message as sent - reply buttons or a list, with the ids.
  ///
  /// A sibling of template_payload rather than a reuse of it, and a new
  /// message TYPE on the existing send path rather than a second path. The
  /// send worker branches on which of the two columns is populated exactly the
  /// way it already branches on template_payload, and everything downstream -
  /// the status ladder, the delivery callbacks, the retry, the thread, the
  /// usage row - needed no change at all.
  ///
  /// Stored rather than rebuilt from the flow version, because the ids in it
  /// name a run and a node and are the only record of what a specific customer
  /// was offered. A flow archived a year later must not make an old thread
  /// unreadable.
  interactivePayload Json? @map("interactive_payload")

  /// Why this message is not going to arrive. Only META rows carry errorCode; a
  /// canSend refusal - the window closed between enqueue and send - writes
  /// POLICY and a sentence a person can act on.
  errorSource MessageFailureSource? @map("error_source")
  errorCode   Int?                  @map("error_code")
  errorTitle  String?               @map("error_title")

  /// The media this message carries, if any. SetNull, not Cascade: media is
  /// shared by content hash, so one message being deleted must not take bytes
  /// the other forty-nine still reference.
  mediaId String? @map("media_id")

  /// How many times a person has asked for this to be sent again. Part of the
  /// send job's id, because BullMQ keeps completed job ids for an hour and a
  /// retry reusing one is silently dropped.
  sendAttempt Int @default(0) @map("send_attempt")

  /// Who pressed send. Null for inbound and for anything a job originated.
  sentByUserId String? @map("sent_by_user_id")

  /// The broadcast this message went out as part of, if any.
  ///
  /// A bulk recipient is an ordinary message row and nothing else: same status
  /// ladder, same retry path, same thread, same usage row. This column is the
  /// only thing that distinguishes one, which is what keeps bulk from becoming
  /// a parallel world with its own idea of what "delivered" means.
  ///
  /// SetNull rather than Cascade: deleting a broadcast's bookkeeping must not
  /// delete messages a customer has already received.
  broadcastId String? @map("broadcast_id")

  /// The one column the thread orders by, and the reason createdAt is not it.
  ///
  /// Inbound carries Meta's own unix-seconds timestamp; outbound is stamped
  /// when we accept it. createdAt is when our worker inserted the row, and a
  /// delayed or retried delivery makes the two diverge by minutes - so a thread
  /// sorted by createdAt shows an order the customer never saw.
  ///
  /// Meta's granularity is one second, so ties are real. Every ordered read
  /// breaks them on id, and the thread index below carries it for that reason.
  occurredAt DateTime @db.Timestamptz(3) @map("occurred_at")

  deliveredAt DateTime? @db.Timestamptz(3) @map("delivered_at")
  readAt      DateTime? @db.Timestamptz(3) @map("read_at")
  failedAt    DateTime? @db.Timestamptz(3) @map("failed_at")

  /// When we wrote the row. Diagnostics only - never an ordering.
  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  media        WhatsAppMedia? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  broadcast    Broadcast?     @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  verseCampaignRecipients VerseCampaignRecipient[]
  /// The lead-source rows that point at this message. At most one in practice;
  /// a list because Prisma models the back side of an optional relation that
  /// way, not because a message can belong to two bindings.
  leadSourceRows LeadSourceRow[]
  /// The flow steps that produced this message. Same shape, same reason.
  flowRunSteps   FlowRunStep[]
  /// SetNull for the same reason as Conversation.assignedUser: deleting an
  /// employee must not delete the messages they sent to customers.
  sentBy       User?          @relation("MessagesSent", fields: [sentByUserId], references: [id], onDelete: SetNull)

  /// Inbound idempotency. Meta redelivers, and a redelivered message must not
  /// appear twice in the thread.
  metaAdReferrals MetaAdReferral[]
  @@unique([companyId, wamid])
  /// The thread read, ordered and tie-broken.
  @@index([companyId, conversationId, occurredAt(sort: Desc), id])
  /// The send worker claims rows by status.
  @@index([companyId, status])
  /// The broadcast report: every recipient of one broadcast, grouped by status.
  @@index([companyId, broadcastId, status])
  @@map("messages")
}

/// Whether the bytes for a piece of media are here.
///
/// Ours to define, so an enum. SKIPPED is not a failure: it is the expected
/// outcome for anything over the size cap, and nothing retries it.
enum MediaState {
  PENDING
  STORED
  SKIPPED
  FAILED

  @@map("media_state")
}

/// Inbound media, stored by content hash.
///
/// Meta's media URLs expire in minutes and need the access token, so storing
/// the URL means broken images tomorrow. The bytes are fetched on receipt.
///
/// ---------------------------------------------------------------------------
/// Content-addressed, and scoped per company
/// ---------------------------------------------------------------------------
///
/// Keyed on the sha256 rather than on Meta's media id: the same image forwarded
/// to fifty contacts arrives as fifty media ids and one hash, and storing it
/// fifty times is fifty downloads and fifty copies in every backup.
///
/// The unique is (company_id, sha256) and deliberately NOT sha256 alone.
/// Deduplicating across tenants is the obvious optimisation and the reason to
/// refuse it is a tenancy argument rather than a technical one: it would make
/// one company's storage cost depend on another's traffic, it would produce a
/// row two companies jointly own - so deleting one company's data would either
/// take the other's bytes or leave them holding a row they cannot account for -
/// and it would let a company learn, by timing, that another tenant already
/// holds a file it is uploading.
///
/// ---------------------------------------------------------------------------
/// Where the bytes live, and for how long
/// ---------------------------------------------------------------------------
///
/// In Postgres, behind MediaStore in packages/db/src/media-store.ts. That is a
/// decision with a named expiry: it inflates every pg_dump and every base
/// backup, so it is revisited when the table passes a few GB. storage_backend
/// and storage_key exist from this first migration so that moving to object
/// storage is a value change and a backfill, not a schema redesign.
model WhatsAppMedia {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  /// Meta's hash of the content, which is also our identity for it. Available
  /// from GET /{media-id} before any transfer, so a duplicate costs one
  /// metadata call and no download at all.
  sha256 String

  /// Meta's vocabulary, so text and not an enum - the same test message.type
  /// answers. Meta forwards whatever the sending handset produced, including
  /// types this build has never seen, and a mime type it does not recognise
  /// must store as itself rather than fail the write that carried it.
  mimeType String @map("mime_type")

  fileName String? @map("file_name")

  /// What Meta said the file is, in bytes. Recorded even when the bytes were
  /// not stored, because the thread renders "6.2 MB, not stored" and needs the
  /// number. A CHECK constraint ties it to octet_length(bytes) when bytes are
  /// present, so the metadata cannot disagree with the content.
  byteSize Int @map("byte_size")

  state MediaState @default(PENDING)

  /// Why there are no bytes. 'over_max_size' is the expected one and is not an
  /// error: the thread shows the reason and the file name, the webhook that
  /// carried it still succeeds, and nothing retries.
  skippedReason String? @map("skipped_reason")

  /// Which MediaStore implementation holds the bytes. Present from the first
  /// migration so that adding 's3' later is a value, not a schema change.
  storageBackend String @default("postgres") @map("storage_backend")
  /// The backend's own handle. Null for 'postgres', where the bytes are below.
  storageKey String? @map("storage_key")

  /// Null unless storage_backend is 'postgres'.
  ///
  /// STORAGE EXTERNAL is set in the migration and is load-bearing rather than a
  /// micro-optimisation: the read path slices this column with substring() to
  /// stream it, and under the default EXTENDED the value is compressed, so a
  /// slice has to decompress from the start and the streaming is a fiction.
  /// JPEG, MP4 and PDF do not compress anyway.
  ///
  /// A CHECK constraint caps it at 5 MiB. The cap is enforced during the
  /// download - the fetch is aborted the moment the running byte count crosses
  /// the limit - because checking a content-length header trusts a remote value
  /// and checking after the fact means a 200 MB response was already resident
  /// in the worker. The constraint is the backstop for both, in the same spirit
  /// as validating a file type by magic bytes rather than by its extension.
  bytes Bytes?

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([companyId, sha256])
  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, state])
  @@map("whatsapp_media")
}

/// One POST from Meta, as received.
///
/// Three jobs, and only the third makes it unavoidable:
///
///   1. Idempotency for the kinds of delivery that have no natural key. The
///      wamid unique covers messages; a status callback has no id of its own
///      and a template or quality update has nothing at all, so a redelivery
///      would re-run the media download and re-record conversation usage.
///   2. The only forensic record in the phase. "The customer says they replied
///      and it is not in the inbox" is unanswerable without the raw delivery.
///   3. It gives the route handler something to do that is ONE statement.
///      Deriving a key by parsing the payload would put the parse inside the
///      five seconds Meta allows before it retries.
/// One 24-hour conversation window Meta told us about, and what they charge for.
///
/// -----------------------------------------------------------------------
/// Its own table, because Meta's conversation is not ours
/// -----------------------------------------------------------------------
///
/// `conversations` is a thread between a contact and one of our numbers, and it
/// lasts for ever. Meta's conversation is a 24-hour BILLING WINDOW: one thread
/// running for a month is thirty of them, each with its own id, category and
/// charge. Storing this on `conversations` would keep the last window and lose
/// the twenty-nine before it, which is the whole bill.
///
/// -----------------------------------------------------------------------
/// Why the row exists at all, beside the usage_events row it produces
/// -----------------------------------------------------------------------
///
/// usage_events records THAT a window was charged, keyed on the id, and the
/// category is folded into the kind. This keeps what Meta actually said - the
/// pricing model that decides how the category is rated, and whether they
/// called it billable in the first place. A non-billable window gets a row and
/// no charge, which is a fact worth having: "we had no marketing conversations"
/// and "we had eleven and Meta billed none of them" are different businesses.
///
/// Phase 11 reprices in arrears from what was recorded rather than from what
/// somebody later assumes the rate card was.
model WhatsAppConversationCharge {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  /// Meta's own id for the window. The unit they bill and dedupe on.
  ///
  /// The same id arrives on many status callbacks - sent, delivered, read, for
  /// every message in the window - so this is the key that makes one charge out
  /// of dozens of notifications.
  metaConversationId String @map("meta_conversation_id")

  /// marketing | utility | authentication | service, verbatim from Meta.
  ///
  /// Nullable because Meta omits the pricing block on some statuses, and a row
  /// that records the window without the category is still worth more than no
  /// row: it says the window existed. Only a category that maps to a
  /// USAGE_KINDS member produces a charge - see conversationUsageKind.
  category String?

  /// CBP, PMP, or whatever Meta names next. Verbatim, never mapped.
  pricingModel String? @map("pricing_model")

  /// What Meta said about whether they are charging for it.
  ///
  /// A free-tier service window is real and is not a charge. Recorded either
  /// way; only `true` writes a usage row.
  billable Boolean @default(false)

  /// The message whose status callback first told us about this window. Kept
  /// for tracing a charge back to something a person can look at.
  firstWamid String? @map("first_wamid")

  /// When Meta's callback said it happened, not when we wrote the row - a
  /// backfill from stored payloads must land on the original instant or a
  /// month's spend moves to the day the backfill ran.
  occurredAt DateTime @db.Timestamptz(3) @map("occurred_at")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// One row per window per company. What makes dozens of status callbacks into
  /// one charge, and what makes the backfill safe to run twice.
  @@unique([companyId, metaConversationId])
  @@index([companyId, occurredAt(sort: Desc)])
  @@map("whatsapp_conversation_charges")
}

model WhatsAppWebhookEvent {
  id            String @id @default(cuid())
  companyId     String @map("company_id")
  integrationId String @map("integration_id")

  /// sha256 of the raw body. Meta redelivers byte-identically, so this is an
  /// exact "seen before" without parsing anything.
  deliveryKey String @map("delivery_key")

  /// The body as received, as text - not parsed jsonb.
  ///
  /// The signature was computed over these exact bytes, so this is the only
  /// form that can be re-verified later, which is the whole point of keeping
  /// it. jsonb would reorder keys and normalise numbers, and the record would
  /// then prove nothing about what Meta actually sent. Parse on read when
  /// debugging.
  ///
  /// Capped at 64 KiB, which is generous for Meta - a large batch of statuses
  /// is a few KB. One strange delivery must not bloat the table.
  payload String

  /// Set when the payload was too large to keep whole. The prefix is still
  /// stored and is still useful for debugging, but it can no longer be
  /// signature-verified, which is worth knowing before trying.
  payloadTruncated Boolean @default(false) @map("payload_truncated")

  /// How many times Meta has delivered this exact body.
  ///
  /// Part of the processing job's id. BullMQ keeps failed job ids for a day,
  /// so re-enqueueing a recovery with the id the first attempt used would be
  /// silently dropped - the same trap as Message.sendAttempt.
  deliveryCount Int @default(1) @map("delivery_count")

  /// Null until the worker has finished with it.
  ///
  /// Load-bearing in two directions. It is what separates "already recorded"
  /// from "already processed", so a redelivery of an event whose job was lost
  /// is re-enqueued rather than discarded. And it is the only thing that makes
  /// a silent failure visible: events older than a few minutes with
  /// processed_at still null are work that vanished, which is a one-line
  /// health check and what Phase 7's dashboard will read.
  processedAt DateTime? @db.Timestamptz(3) @map("processed_at")

  /// Why nothing was done with it. 'company_deactivated' is the one that is not
  /// an error - the resolver deliberately answers for a suspended company, and
  /// the refusal happens here instead.
  skippedReason String? @map("skipped_reason")
  error         String?

  /// When Meta's delivery arrived. Also what the retention prune reads.
  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([companyId, deliveryKey])
  /// The retention prune, and the operator's "what arrived recently".
  @@index([companyId, createdAt(sort: Desc)])
  /// The unprocessed backlog, which is the health check.
  @@index([companyId, processedAt])
  @@map("whatsapp_webhook_events")
}

/// Why a delivery could not be accepted. Ours to define, so an enum.
enum UnroutableReason {
  /// The path segment matches no WhatsApp integration. A rotated key, a stale
  /// Meta config, or somebody probing.
  UNKNOWN_KEY
  /// The key resolves but X-Hub-Signature-256 did not verify. Usually a stale
  /// app secret on a real tenant; sometimes a forgery.
  BAD_SIGNATURE

  @@map("unroutable_reason")
}

/// Deliveries that arrived and could not be accepted.
///
/// Global on purpose: an unknown key has no company to attribute the row to,
/// which is the whole reason this table is separate from
/// whatsapp_webhook_events. Listed in GLOBAL_TABLES with that reason.
///
/// Attacker-writable, and bounded accordingly - see the migration. One row per
/// key hash with a counter, never one row per request, and the real bound is
/// the per-IP throttle in front of it.
model UnroutableWebhook {
  id String @id @default(cuid())

  /// sha256 of the path segment, not the segment itself.
  ///
  /// For BAD_SIGNATURE this is a real tenant's live webhook key, and this table
  /// is readable by the platform admin rather than by the tenant. Storing the
  /// hash means an operator can correlate reports without the table becoming a
  /// list of working webhook URLs.
  webhookKeyHash String @unique @map("webhook_key_hash")

  reason UnroutableReason

  /// Null for UNKNOWN_KEY, which by definition resolves to no company.
  /// Populated for BAD_SIGNATURE, because "every delivery to this tenant is
  /// failing verification" is only actionable if you can say whose.
  companyId String? @map("company_id")

  /// Hash of the most recent source address. Not a history - the throttle
  /// bounds abuse, this only helps an operator tell one persistent source from
  /// scattered noise.
  lastIpHash String? @map("last_ip_hash")

  attemptCount Int      @default(1) @map("attempt_count")
  firstSeenAt  DateTime @db.Timestamptz(3) @default(now()) @map("first_seen_at")
  lastSeenAt   DateTime @db.Timestamptz(3) @default(now()) @map("last_seen_at")

  /// SetNull, not Cascade: deleting a company should not erase the evidence
  /// that something was still posting to its old webhook.
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  /// The retention prune, and the operator's "what is failing now".
  @@index([lastSeenAt(sort: Desc)])
  @@index([companyId, lastSeenAt(sort: Desc)])
  @@map("unroutable_webhooks")
}

/// One countable thing that happened, priced at the moment it happened.
///
/// cost_cents is stamped by the emitter rather than derived when the overview
/// renders. Billing that recomputes historical cost from today's price list
/// silently rewrites what a customer already owed the moment the list changes;
/// this way repricing only ever affects the future, and the read path is a SUM.
///
/// `kind` is text, not an enum, because the price list in @whatsapp-os/core is
/// the source of truth for what kinds exist - USAGE_PRICES is keyed by
/// (kind, currency, version), so a kind that nothing has priced does not
/// compile. A second list in the database could only disagree with it. Every
/// write goes through recordUsage(), which takes the union.
/// A message template, in the exact shape Meta was given.
///
/// -----------------------------------------------------------------------
/// `components` is jsonb and is the submission, not a rendering of it
/// -----------------------------------------------------------------------
///
/// Decision 10. The Studio's preview and the Graph POST read this one value,
/// so what a tenant approved on screen cannot drift from what Meta received.
/// Storing a normalised header/body/footer/buttons split instead would mean
/// two assemblies of the same thing - one for the preview, one for the wire -
/// and the day they disagree is the day somebody's customer gets a message
/// nobody reviewed.
///
/// It is Meta's schema, not ours, which is the other half of the argument: the
/// component vocabulary is theirs to extend, and a column per field would need
/// a migration every time they add one.
model WhatsAppTemplate {
  id            String @id @default(cuid())
  companyId     String @map("company_id")
  /// Which WABA it lives under. Meta scopes templates to the business account.
  integrationId String @map("integration_id")

  /// lowercase_snake_case, as Meta requires. Slugified in the Studio, not here.
  name     String
  /// Meta's locale code, e.g. en_US. Text: the list is long and theirs.
  language String

  /// MARKETING, UTILITY or AUTHENTICATION - and text rather than an enum for
  /// the usual reason, plus a sharper one. Meta RE-CATEGORISES templates whose
  /// wording it reads as promotional, so the value here can change to something
  /// the tenant did not choose, and the price changes with it. A write that
  /// rejected an unfamiliar category would drop exactly that news.
  category String

  /// The components array, byte-for-byte what was POSTed.
  components Json

  /// Meta's vocabulary: PENDING, APPROVED, REJECTED, PAUSED, DISABLED,
  /// IN_APPEAL - and whatever they add next, which must render as itself.
  status String @default("PENDING")

  /// Meta's id, once it accepts the submission. Null until then, which is what
  /// distinguishes "never submitted" from "submitted and waiting".
  metaTemplateId String? @map("meta_template_id")

  /// Meta's own words for why it said no, stored verbatim. Paraphrasing it
  /// would put our sentence in front of the person who has to act on theirs.
  rejectedReason String? @map("rejected_reason")

  /// When Meta last told us anything about this template.
  statusUpdatedAt DateTime? @db.Timestamptz(3) @map("status_updated_at")

  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// SetNull, like every other authorship column here: deleting an employee
  /// must not delete the template their colleagues are sending.
  createdBy   User?       @relation("TemplatesCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  edits       WhatsAppTemplateEdit[]
  broadcasts  Broadcast[]
  leadSources LeadSource[]
  verseCampaigns VerseCampaign[]
  flowVersions FlowVersion[]

  /// Meta's own uniqueness rule, scoped per company so it is a tenant fact.
  @@unique([companyId, name, language])
  @@index([companyId, updatedAt(sort: Desc)])
  @@index([companyId, status])
  @@map("whatsapp_templates")
}

/// One edit, appended. Never updated, never deleted.
///
/// -----------------------------------------------------------------------
/// The quota is DERIVED from these rows, and there is no counter column
/// -----------------------------------------------------------------------
///
/// A counter is a second source of truth for something the rows already say,
/// and it is wrong the first time a write half-fails. Counting is cheap at this
/// cardinality - a template is edited a handful of times in a month, and the
/// index below makes the window a seek.
///
/// R8: what that count produces is a FLOOR, not the quota. Meta counts edits
/// made in Business Manager too, and those never reach this table. The Studio
/// labels it "edits made here" for that reason, and the Edit button is never
/// the enforcement - submitting attempts it and decodes Meta's refusal.
model WhatsAppTemplateEdit {
  id         String @id @default(cuid())
  companyId  String @map("company_id")
  templateId String @map("template_id")

  /// The components as submitted by THIS edit, so the log is a history of what
  /// was actually sent rather than a list of timestamps.
  components Json

  editedByUserId String? @map("edited_by_user_id")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template WhatsAppTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  editedBy User?            @relation("TemplateEdits", fields: [editedByUserId], references: [id], onDelete: SetNull)

  /// The window count: every read is "edits to this template since T".
  @@index([companyId, templateId, createdAt(sort: Desc)])
  @@map("whatsapp_template_edits")
}

/// Which of the three documents a row carries.
///
/// Fixed, and short by design: KYC here is the Indian business-verification
/// set, so the vocabulary is ours rather than a provider's and an enum is
/// right where whatsapp_numbers.status is text. A fourth kind would be a
/// migration AND a product decision about what an account must produce before
/// it is allowed to work, which is the review moment an enum forces and a text
/// column would skip.
enum KycDocumentKind {
  GST
  PAN
  AADHAAR

  @@map("kyc_document_kind")
}

/// Where one upload stands with the platform operator.
///
/// REJECTED covers a revoked approval as well as a first refusal. Both mean
/// "this document is not accepted, here is why, upload another", which is the
/// only distinction the tenant can act on - and the two are told apart in
/// admin_audit_log, where the difference actually matters. Adding a REVOKED
/// member would give the gate two ways to spell the same closed door.
enum KycDocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("kyc_document_status")
}

/// One upload attempt. Append-only: a re-upload supersedes, never overwrites.
///
/// -------------------------------------------------------------------------
/// The current state of a kind is the newest row for it
/// -------------------------------------------------------------------------
///
/// Following whatsapp_template_edits. A rejected document whose replacement is
/// approved leaves both rows behind, so "what did the operator actually look
/// at when they let this company in" has an answer a year later. Overwriting
/// would destroy exactly the record that identity documents need, and it is
/// not recoverable once done.
///
/// The consequence for every reader: there is no "the GST document" row. There
/// is the newest row of kind GST, and currentKycDocuments() in src/kyc.ts is
/// the only place that ordering is written down.
///
/// -------------------------------------------------------------------------
/// Why this is not whatsapp_media
/// -------------------------------------------------------------------------
///
/// whatsapp_media is unique on (company_id, sha256) and upserts onto it, which
/// is right for a photo forwarded to fifty contacts and wrong for this: two
/// companies filing the same PDF must never meet in one row, and even one
/// company re-uploading identical bytes after a rejection is a new attempt
/// with its own verdict. The MediaStore *pattern* is reused - bytea, STORAGE
/// EXTERNAL, a CHECK on length, chunked reads - and the table is not.
model KycDocument {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  kind KycDocumentKind

  /// The file. NOT NULL, unlike whatsapp_media.bytes: there is no equivalent
  /// of a skipped download here, because nothing creates a row except an
  /// upload that already arrived intact.
  ///
  /// STORAGE EXTERNAL is set in the migration and is load-bearing for the same
  /// reason it is there - the read path slices this column with substring() to
  /// stream it, and under the default EXTENDED every slice decompresses from
  /// the start.
  ///
  /// Three CHECK constraints in the migration: the 5 MiB cap, byte_size
  /// agreeing with the content, and the first five bytes being %PDF-. All
  /// three are backstops for checks the upload path already makes, in the
  /// spirit of validating a file by its magic bytes rather than its name.
  bytes Bytes

  byteSize Int    @map("byte_size")
  sha256   String

  /// What the browser called it. Recorded, never trusted: the download route
  /// sanitises it into Content-Disposition the way the media route does.
  mimeType         String @map("mime_type")
  originalFilename String @map("original_filename")

  status KycDocumentStatus @default(PENDING)

  /// Who decided, when, and why. Null until somebody has.
  ///
  /// SetNull rather than Cascade: an operator leaving the company must not
  /// delete the record of the approval that let a tenant start trading. The
  /// verdict outlives the person who gave it.
  reviewedByAdminId String?   @map("reviewed_by_admin_id")
  reviewedAt        DateTime? @db.Timestamptz(3) @map("reviewed_at")

  /// Required on a rejection and on a revocation, because it is the only thing
  /// the tenant is shown about either. An empty reason is a dead end wearing a
  /// status chip.
  reviewNote String? @map("review_note")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  company         Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewedByAdmin AdminUser? @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  /// The only read there is: the newest row of a kind, for one company.
  @@index([companyId, kind, createdAt(sort: Desc)])
  @@map("kyc_documents")
}

/// Where one bulk send has got to.
///
/// DRAFT is the audience without a decision attached, which is why it exists
/// at all: an imported list has to survive the mapping and confirm steps, and
/// a browser refresh in the middle of them, before anybody has said send.
///
/// PAUSED and CANCELLED are read by every send job as it runs, which is what
/// makes them immediate without touching the delayed jobs already in Redis.
/// CANCELLED is terminal; PAUSED is not.
enum BroadcastStatus {
  DRAFT
  RUNNING
  PAUSED
  CANCELLED
  COMPLETED

  @@map("broadcast_status")
}

/// What happened to one row of the imported list.
///
/// SKIPPED is not a failure and carries its own reason - opted out since
/// import, undeliverable, or the broadcast was cancelled before reaching it.
/// A row that became a message is SENT here regardless of what Meta then said;
/// the message's own status ladder is what says whether it arrived.
enum BroadcastRecipientState {
  PENDING
  SENT
  SKIPPED

  @@map("broadcast_recipient_state")
}

/// One bulk send: an audience, a template, and a pace.
model Broadcast {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  /// What the tenant called it. Defaults to the uploaded filename.
  name String

  /// The approved template every recipient receives.
  ///
  /// Required and never null: a bulk recipient is cold, there is no open
  /// 24-hour window, and only a template may be sent. That is Meta's rule
  /// rather than ours, and sendPolicy already enforces it - this column is the
  /// schema saying the same thing, so a free-form broadcast is not merely
  /// disabled but unrepresentable.
  templateId String @map("template_id")

  /// The number it sends from. Its messaging tier is the real ceiling.
  whatsappNumberId String @map("whatsapp_number_id")

  status BroadcastStatus @default(DRAFT)

  /// Which CSV column feeds the phone number and each template variable.
  ///
  /// jsonb because the shape is `{ phone: "Mobile", variables: { "1": "Name" } }`
  /// and the variable count comes from the template, not from us. Kept after
  /// the send so the report can say what a recipient was actually told.
  columnMapping Json? @map("column_mapping")

  /// Milliseconds between sends, copied from the company at start.
  ///
  /// Copied rather than read live, so that changing the tenant setting does
  /// not silently re-pace a broadcast already running - and so the report can
  /// say what pace this one actually ran at.
  gapMs Int @map("gap_ms")

  /// The cleaning pipeline's counts, frozen at import.
  ///
  /// Stored rather than recomputed because they describe a file that no longer
  /// exists: "1,204 parsed, 11 unparseable, 38 duplicates, 92 already
  /// contacts, 4 opted out" is the audit of one upload and cannot be derived
  /// from the recipients that survived it.
  sourceFilename String? @map("source_filename")

  /// The parsed upload, for the life of the wizard only.
  ///
  /// The import step writes it, the mapping step reads headers and a preview
  /// out of it, and confirming builds the recipients and sets it back to NULL.
  /// It is a customer list - names, numbers, order values - and keeping a
  /// second copy in a column nothing reads would be quiet data retention that
  /// is indefensible when somebody asks what you hold.
  sourceRows    Json? @map("source_rows")
  /// The CSV's header row, kept separately so the mapping screen can offer the
  /// columns in file order rather than whatever order a JSON object iterates.
  sourceHeaders Json? @map("source_headers")
  parsedCount    Int     @default(0) @map("parsed_count")
  invalidCount   Int     @default(0) @map("invalid_count")
  duplicateCount Int     @default(0) @map("duplicate_count")
  existingCount  Int     @default(0) @map("existing_count")
  optedOutCount  Int     @default(0) @map("opted_out_count")
  /// What is left, and what the confirm screen counts.
  recipientCount Int     @default(0) @map("recipient_count")

  createdByUserId String? @map("created_by_user_id")

  startedAt  DateTime? @db.Timestamptz(3) @map("started_at")
  finishedAt DateTime? @db.Timestamptz(3) @map("finished_at")
  createdAt  DateTime  @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt  DateTime  @db.Timestamptz(3) @updatedAt @map("updated_at")

  company        Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template       WhatsAppTemplate     @relation(fields: [templateId], references: [id], onDelete: Restrict)
  whatsappNumber WhatsAppNumber       @relation(fields: [whatsappNumberId], references: [id], onDelete: Restrict)
  createdBy      User?                @relation("BroadcastsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients     BroadcastRecipient[]
  messages       Message[]

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@map("broadcasts")
}

/// One row of the imported list, after cleaning.
///
/// -------------------------------------------------------------------------
/// Why this exists when a recipient is supposed to be a message row
/// -------------------------------------------------------------------------
///
/// A SENT recipient is an ordinary message row and nothing else - that is the
/// rule, and message_id below is where the two meet. What this table holds is
/// the audience BEFORE anybody has decided to send it.
///
/// Message rows cannot do that job. PENDING is the status the send worker
/// claims by, so a draft's recipients sitting in `messages` would be sent by
/// the first worker that looked, with nobody having pressed anything. Adding a
/// pre-send status to the ladder would put a state into the one enum every
/// delivery callback and every retry already reasons about, to describe rows
/// that are not messages yet.
///
/// So the audience lives here until it is sent, and then it is a message.
model BroadcastRecipient {
  id          String @id @default(cuid())
  companyId   String @map("company_id")
  broadcastId String @map("broadcast_id")

  /// E.164, from parsePhone with the India default. Cleaned at import.
  phoneE164 String @map("phone_e164")

  /// The template's parameters for this row, in Meta's positional order.
  ///
  /// A JSON array, not an object: Meta matches {{1}}, {{2}} by position, and
  /// storing them keyed would need the mapping re-read to put them back in
  /// order at send time.
  variables Json

  state      BroadcastRecipientState @default(PENDING)
  /// Why this row was not sent. Null unless state is SKIPPED.
  skipReason String?                 @map("skip_reason")

  /// The message this became. Null until the send job created one.
  messageId String? @map("message_id")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  /// The drip walks this: one broadcast's pending rows, in a stable order.
  @@index([companyId, broadcastId, state])
  /// Deduping within one import is done in memory before the insert; this
  /// makes a second import of the same file into the same broadcast a
  /// constraint violation rather than a doubled send.
  @@unique([broadcastId, phoneE164])
  @@map("broadcast_recipients")
}

/// What a binding does when a new row appears.
///
/// One member today. A1's flow builder and A2's AI layer are both meant to
/// become alternative actions on the same binding - the same sheet, the same
/// mapping, the same cleaning, a different thing at the end - so the kind is a
/// column from the start rather than an assumption spread across a poll job, a
/// form and a report. The CHECK in 20260902090000 ties each arm to the target
/// it needs.
/// What a binding does with a row it has not seen before.
///
/// The discriminated column that Phase 6 built with one member and said was
/// meant to gain a second. This is the second, and wiring it is what proves
/// the shape was right: a binding keeps its sheet, its tab, its mapping, its
/// cleaning, its cursor and its idempotency index, and only the last step
/// changes. Nothing in the poll handler above the action switch moved.
enum LeadSourceAction {
  /// Send one approved template and stop. The original.
  TEMPLATE
  /// Start a flow, whose entry node sends an approved template with
  /// quick-reply buttons - so the row is contacted exactly as a TEMPLATE
  /// binding would contact it, and what differs is that a tap now goes
  /// somewhere.
  FLOW
  /// Enrol the row in a Verse campaign: the campaign's approved template opens
  /// the conversation, and what the customer writes back is answered from the
  /// campaign's knowledge base. The third member, added by its own migration
  /// because PostgreSQL will not let a new enum value be used in the
  /// transaction that added it.
  VERSE

  @@map("lead_source_action")
}

/// Whether a binding is polling, and why it is not.
///
/// ERROR is a state the tenant has to see rather than a log line: a binding
/// that has lost access to its sheet looks identical to one with no new leads,
/// and the difference is a customer list nobody is being contacted from.
enum LeadSourceStatus {
  ACTIVE
  PAUSED
  ERROR

  @@map("lead_source_status")
}

/// What happened to one row of the sheet.
///
/// SKIPPED is not a failure and carries its own reason - opted out, or a
/// handset that cannot receive WhatsApp. A row that became a message is SENT
/// here regardless of what Meta then said; the message's own status ladder is
/// what says whether it arrived.
enum LeadSourceRowState {
  SENT
  SKIPPED

  @@map("lead_source_row_state")
}

/// A bound spreadsheet, and what it does with a new row.
model LeadSource {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  /// What the tenant called it. Defaults to the tab name.
  name String

  /// Google's own id, parsed out of whatever was pasted.
  spreadsheetId String @map("spreadsheet_id")
  /// The tab TITLE, because that is what the values API takes as a range.
  ///
  /// The gid is kept beside it only to link back into Google at the right tab.
  /// Reading by gid would silently follow a rename; reading by title turns a
  /// renamed tab into a visible error on the binding, which is the honest
  /// outcome - the tenant renamed something and needs to say what they meant.
  tab      String
  sheetGid Int?   @map("sheet_gid")

  action LeadSourceAction @default(TEMPLATE)
  /// The mapping, and anything else the action needs.
  ///
  /// jsonb because the variable count comes from the template rather than from
  /// us - the same reason broadcasts.column_mapping is.
  actionConfig Json @map("action_config")

  /// Required for a TEMPLATE binding, by CHECK constraint rather than by
  /// convention. Cold recipients, so template-only.
  templateId       String? @map("template_id")
  /// Required for a FLOW binding, by the same CHECK constraint.
  ///
  /// A VERSION rather than a flow, and deliberately: a run pins the version it
  /// started on, and a binding that named the flow would put every row it read
  /// into whatever happened to be published that minute. Naming the version
  /// means a tenant republishing mid-import does not split one afternoon's
  /// leads across two trees. Repointing the binding at the new version is a
  /// deliberate edit on its page.
  flowVersionId    String? @map("flow_version_id")
  /// The third member of the action column. A binding keeps its sheet, its
  /// tab, its mapping, its cleaning, its cursor and its idempotency index;
  /// only the last step changes. Tied to `action` by a CHECK.
  verseCampaignId  String? @map("verse_campaign_id")
  whatsappNumberId String  @map("whatsapp_number_id")

  status              LeadSourceStatus @default(ACTIVE)
  pollIntervalSeconds Int              @default(30) @map("poll_interval_seconds")

  /// Data rows already looked at.
  cursorCount Int @default(0) @map("cursor_count")
  /// Hash of the last row seen, over every cell rather than the mapped ones.
  ///
  /// Without it the count is wrong in both directions and silent in both: a
  /// deletion puts it past the end of the sheet and the binding never sends
  /// again, and a mid-sheet insert shifts an already-sent row into its place
  /// while the new one above it is never looked at.
  cursorAnchor String? @map("cursor_anchor")

  rowsSeen     Int @default(0) @map("rows_seen")
  rowsSent     Int @default(0) @map("rows_sent")
  rowsSkipped  Int @default(0) @map("rows_skipped")
  rowsRejected Int @default(0) @map("rows_rejected")
  /// Rows another binding on the same spreadsheet had already claimed.
  rowsDuplicate Int @default(0) @map("rows_duplicate")

  /// Rejects by reason, aggregated: {"unparseable_phone": 12}.
  ///
  /// Not a row per reject. A broken mapping rejects every row of a growing
  /// sheet on every poll, so the table would grow without bound - and it would
  /// be a second copy of phone numbers we chose not to keep.
  rejectReasons Json @default("{}") @map("reject_reasons")

  lastPolledAt DateTime? @db.Timestamptz(3) @map("last_polled_at")
  lastSentAt   DateTime? @db.Timestamptz(3) @map("last_sent_at")
  /// Already scrubbed by the adapter. Safe to show a tenant.
  lastError   String?   @map("last_error")
  lastErrorAt DateTime? @db.Timestamptz(3) @map("last_error_at")

  /// Quota back-off. A poll that finds this in the future does nothing.
  ///
  /// In the database rather than only in Redis, so it survives a worker restart
  /// and so the binding's page can say why nothing is happening.
  backoffUntil DateTime? @db.Timestamptz(3) @map("backoff_until")

  /// The unguessable segment of this binding's optional Apps Script URL.
  ///
  /// Per binding rather than reusing the integration's, so deleting a binding
  /// revokes exactly its own script - and so rotating it cannot silently break
  /// the WhatsApp webhook, which lives in that other column.
  ///
  /// Resolved by app_resolve_company's `lead_source` kind, because a request
  /// from Apps Script carries no session and a company id may never come from
  /// a request body.
  webhookKey String @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)")) @map("webhook_key")

  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template       WhatsAppTemplate? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  flowVersion    FlowVersion?      @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  verseCampaign  VerseCampaign?    @relation(fields: [verseCampaignId], references: [id], onDelete: Restrict)
  whatsappNumber WhatsAppNumber    @relation(fields: [whatsappNumberId], references: [id], onDelete: Restrict)
  createdBy      User?             @relation("LeadSourcesCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  rows           LeadSourceRow[]

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@index([companyId, verseCampaignId])
  @@map("lead_sources")
}

/// One lead the system has acted on.
///
/// -------------------------------------------------------------------------
/// This table exists for its unique index and nothing else
/// -------------------------------------------------------------------------
///
/// A poll reads a spreadsheet somebody else is editing, on a schedule, for
/// ever. Every mechanism above the database - a cursor, an anchor, a Set of
/// hashes - is an optimisation that can be wrong, and the cost of being wrong
/// is a real customer receiving the same WhatsApp message twice. That cannot
/// be un-sent.
///
/// So the guarantee is one unique index, checked inside the transaction that
/// creates the message. Not a "have we seen this" query run beforehand: that
/// has a window between the check and the insert, and a poll running every
/// thirty seconds beside a retrying job will find it.
///
/// It deliberately holds no copy of the sheet. The hash, the number it resolved
/// to, and what happened - the spreadsheet is the tenant's, and a shadow of it
/// is retention nobody asked for.
model LeadSourceRow {
  id           String @id @default(cuid())
  companyId    String @map("company_id")
  leadSourceId String @map("lead_source_id")

  /// Denormalised from the binding, because a join cannot carry a unique index.
  spreadsheetId String @map("spreadsheet_id")
  /// Which tab of it, for the same reason.
  ///
  /// Part of the key since 20260904090000. Two bindings on different tabs of
  /// one workbook is an ordinary setup - separate sheets of enquiries feeding
  /// separate templates - and without this the second one is permanently dead:
  /// every row it reads collides with a hash the first already claimed.
  tab String

  /// sha256 over the E.164 number and the template's variable values.
  ///
  /// Deliberately not the row's position: an insert at the top shifts every row
  /// below it, and a position-sensitive hash would re-send the entire sheet to
  /// everybody on it.
  rowHash String @map("row_hash")

  phoneE164 String @map("phone_e164")

  state LeadSourceRowState @default(SENT)
  /// Why nothing was sent. Null unless state is SKIPPED, by CHECK constraint.
  skipReason String? @map("skip_reason")

  /// The message this became. Null when the row was skipped.
  messageId String? @map("message_id")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leadSource LeadSource @relation(fields: [leadSourceId], references: [id], onDelete: Cascade)
  message    Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)

  /// The guarantee. Per (spreadsheet, tab) rather than per binding: two
  /// bindings on the SAME tab would otherwise both message every row, and the
  /// customer hears from the business twice for one enquiry. The binding that
  /// loses counts it as a duplicate and its page says so, so it is not silent.
  ///
  /// The tab is in the index rather than in rowHash because a hash input cannot
  /// be added to hashes already written - and re-hashing every stored row makes
  /// all of them look new, which is a message to every customer a tenant has
  /// ever imported.
  @@unique([companyId, spreadsheetId, tab, rowHash])
  /// The binding's live feed: its most recent rows, newest first.
  @@index([companyId, leadSourceId, createdAt(sort: Desc)])
  @@map("lead_source_rows")
}

/// A run's position in its flow.
///
/// PAUSED is the member that carries the phase's second unretrofittable
/// decision. A customer stops replying for a day and the 24-hour window shuts
/// with the run halfway down the tree: nothing has gone wrong, the flow simply
/// cannot speak until spoken to. Failing it would discard the customer's
/// answers and show an operator an error for something that is merely waiting.
///
/// HANDED_OFF is kept apart from COMPLETED deliberately. Both are endings, but
/// one of them is the flow saying it could not finish the job - and a report
/// that called them the same thing would hide the question every tenant asks
/// first, which is how often the automation gives up.
enum FlowRunStatus {
  ACTIVE
  PAUSED
  COMPLETED
  HANDED_OFF
  FAILED

  @@map("flow_run_status")
}

/// What one appended step records.
///
/// Ours, so an enum. The vocabulary is chosen so that reading a run's steps
/// answers the two questions an operator actually has - what did we send, and
/// why did it stop - without joining anything.
enum FlowStepKind {
  /// The run was created, at the entry node.
  STARTED
  /// A message went out for a node. Carries the message it became.
  SENT
  /// A tap or a typed reply moved the run. Carries the choice key.
  ADVANCED
  /// An action node wrote something down. Carries what, in detail.
  ACTION
  /// The window shut before an outbound step. The position is kept.
  PAUSED
  /// An entry template picked a paused run back up where it left off.
  RESUMED
  /// A tap that named a node this run had already left, or a run that had
  /// ended. Acknowledged, recorded, and deliberately not executed.
  DECLINED
  /// end or handoff.
  ENDED
  /// The step ceiling, or something that could not be recovered from.
  FAILED

  @@map("flow_step_kind")
}

/// How warm a lead is, as a flow's action node set it.
///
/// Three members and no numeric score. A number invites arithmetic - an
/// average lead score is not a quantity that means anything - and it invites a
/// scale nobody agrees on. What a tenant draws in the builder is "this answer
/// makes them hot", which is these three and nothing else.
enum LeadScore {
  HOT
  WARM
  COLD

  @@map("lead_score")
}

/// A decision tree the tenant drew.
///
/// The flow itself holds almost nothing: a name, and a pointer at the version
/// that is live. Everything that describes behaviour is on a version, because
/// behaviour is the thing a run has to be pinned to.
model Flow {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  name String

  /// The version customers are being put into. Null means nothing is live.
  ///
  /// A pointer rather than a flag on the version, so "which one is live" has
  /// exactly one answer. Two published versions is not a state this schema can
  /// represent, which is the point - publishing is moving this pointer.
  publishedVersionId String? @unique @map("published_version_id")

  /// Set rather than deleted. A flow with runs in its history is a record of
  /// what customers were told, and deleting it would take the runs with it.
  archivedAt DateTime? @db.Timestamptz(3) @map("archived_at")

  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy User?   @relation("FlowsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// The live version. NoAction rather than Cascade or SetNull, because the
  /// cycle between these two tables has to be broken somewhere: a version's
  /// flow_id cascades, and this side does nothing, so deleting a flow deletes
  /// its versions rather than the two referential actions chasing each other.
  publishedVersion FlowVersion? @relation("FlowPublishedVersion", fields: [publishedVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  versions FlowVersion[] @relation("FlowVersions")
  runs     FlowRun[]

  @@index([companyId, createdAt(sort: Desc)])
  @@map("flows")
}

/// One saved state of a tree, draft or published.
///
/// -------------------------------------------------------------------------
/// Why a run pins one of these, and what it costs not to
/// -------------------------------------------------------------------------
///
/// A customer is three questions into a flow. The tenant opens the builder,
/// deletes the branch that customer is standing on, and publishes. If runs
/// read the flow's current graph, that customer's next tap arrives naming a
/// node that no longer exists - and the honest thing the runtime could do with
/// it is nothing at all.
///
/// So a run names a version and never changes it. Editing a published flow
/// creates a new draft; publishing moves the flow's pointer; and every run
/// already in flight finishes on the tree it started on. The cost is that a
/// fix to a live flow does not reach the customers currently in it, which is
/// the right trade: they are mid-conversation, and changing the questions
/// underneath somebody mid-conversation is the worse outcome.
model FlowVersion {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  flowId    String @map("flow_id")

  /// Monotonic per flow, and what the builder shows. Version 3 of a flow is a
  /// thing people say to each other.
  version Int

  /// The tree, validated by validateFlow in @whatsapp-os/core/flows.
  ///
  /// jsonb rather than a table of nodes and a table of edges, and the reason
  /// is the pinning above: a version is immutable once published and is read
  /// whole on every advance. Normalised, "the tree as it was" becomes a join
  /// across two tables that both have to be versioned too, and the immutability
  /// stops being a property of one row.
  graph Json

  /// The template the entry node sends, denormalised out of the graph.
  ///
  /// Here so it can carry a foreign key. Restrict, not Cascade: deleting a
  /// template that a published flow opens with would leave a flow whose only
  /// legal entry point is gone, and it would fail at the moment a customer
  /// arrived rather than at the moment somebody pressed delete.
  entryTemplateId String @map("entry_template_id")

  /// Null while this is a draft. Set once, when it goes live.
  publishedAt       DateTime? @db.Timestamptz(3) @map("published_at")
  publishedByUserId String?   @map("published_by_user_id")

  createdByUserId String? @map("created_by_user_id")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flow        Flow             @relation("FlowVersions", fields: [flowId], references: [id], onDelete: Cascade)
  template    WhatsAppTemplate @relation(fields: [entryTemplateId], references: [id], onDelete: Restrict)
  createdBy   User?            @relation("FlowVersionsCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  publishedBy User?            @relation("FlowVersionsPublished", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  /// The back side of Flow.publishedVersionId.
  publishedForFlow Flow[] @relation("FlowPublishedVersion")
  runs             FlowRun[]
  leadSources      LeadSource[]

  @@unique([companyId, flowId, version])
  @@index([companyId, flowId, version(sort: Desc)])
  @@map("flow_versions")
}

/// One customer's journey through one version of one flow.
model FlowRun {
  id            String @id @default(cuid())
  companyId     String @map("company_id")
  flowId        String @map("flow_id")
  /// The pin. Never updated after insert.
  flowVersionId String @map("flow_version_id")

  conversationId String @map("conversation_id")
  contactId      String @map("contact_id")

  /// A duplicate of conversation_id, present only while the run is live.
  ///
  /// -----------------------------------------------------------------------
  /// A redundant column, because the guarantee it buys is not expressible
  /// otherwise
  /// -----------------------------------------------------------------------
  ///
  /// A conversation must never be in two flows at once - two runs would both
  /// send, both wait, and the customer would get two questions and be able to
  /// answer only one. But a conversation may hold many FINISHED runs, because
  /// a customer coming back next month is an ordinary thing.
  ///
  /// That is a partial unique index - unique on conversation WHERE the status
  /// is live - and schema.prisma cannot express one, so a hand-written partial
  /// index would show up as permanent drift on every `prisma migrate diff`.
  ///
  /// Postgres treats NULLs as distinct, which is the same property that lets
  /// messages.wamid be unique while many pending sends carry none. So this
  /// column holds the conversation while the run is live and NULL once it is
  /// not, and the plain unique below does the work. Two CHECK constraints in
  /// the migration keep it honest: it is non-null exactly when the status is
  /// live, and when non-null it equals conversation_id.
  activeConversationId String? @map("active_conversation_id")

  status FlowRunStatus @default(ACTIVE)

  /// Where the customer is standing. Null once the run has ended.
  currentNodeId String? @map("current_node_id")

  /// What the flow has collected, as {"want": "shoes"}.
  ///
  /// Per run rather than on the contact, because these are answers to this
  /// conversation's questions. A "size" collected in a shoe flow is not a fact
  /// about the person that a later flow should read.
  variables Json @default("{}")

  /// Steps taken over the run's whole life. The ceiling reads this.
  stepCount Int @default(0) @map("step_count")

  /// Why it stopped, when it stopped badly. Safe to show a tenant.
  lastError String? @map("last_error")

  startedAt DateTime  @db.Timestamptz(3) @default(now()) @map("started_at")
  /// When the window shut on it. Null unless it is or has been paused.
  pausedAt  DateTime? @db.Timestamptz(3) @map("paused_at")
  endedAt   DateTime? @db.Timestamptz(3) @map("ended_at")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flow         Flow         @relation(fields: [flowId], references: [id], onDelete: Cascade)
  flowVersion  FlowVersion  @relation(fields: [flowVersionId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  steps        FlowRunStep[]

  /// One live run per conversation. See activeConversationId above.
  @@unique([companyId, activeConversationId])
  /// The thread's own history, and the inbox's "is this thread automated".
  @@index([companyId, conversationId, startedAt(sort: Desc)])
  /// The flow's report: every run of one flow, grouped by how it ended.
  @@index([companyId, flowId, status])
  @@map("flow_runs")
}

/// What a run did, one row at a time, for ever.
///
/// -------------------------------------------------------------------------
/// Append-only, and enforced by a revoked grant rather than by convention
/// -------------------------------------------------------------------------
///
/// This table is the only record of what a customer was actually asked and
/// what they actually answered. A flow's version is immutable, but the run's
/// path through it is the thing a dispute is about - "your bot told me it was
/// in stock" - and a row that can be updated is a record that can be tidied.
///
/// app_runtime holds SELECT and INSERT here and neither UPDATE nor DELETE, so
/// the guarantee is the database's rather than a rule somebody remembers. The
/// waiver is named in APPEND_ONLY_TABLES in schema-invariants.test.ts, which
/// otherwise requires full CRUD on every tenant table - so removing it is a
/// visible diff in a security test.
model FlowRunStep {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  flowRunId String @map("flow_run_id")

  /// Position in the run, from 1. Unique per run, so two writers cannot both
  /// think they were step 4.
  seq Int

  kind FlowStepKind

  /// The node this step is about. Text, not a foreign key: nodes live inside a
  /// version's jsonb, and a step has to survive being read after the flow it
  /// belonged to was archived.
  nodeId String? @map("node_id")

  /// The choice key the customer tapped, for an ADVANCED step.
  choice String?

  /// The message this step sent. Null for everything that sends nothing.
  messageId String? @map("message_id")

  /// Everything else, keyed by what the step was: the variables an ADVANCED
  /// step set, the actions an ACTION step performed, the reason a DECLINED
  /// step declined.
  detail Json @default("{}")

  occurredAt DateTime @db.Timestamptz(3) @default(now()) @map("occurred_at")

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  flowRun FlowRun  @relation(fields: [flowRunId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([companyId, flowRunId, seq])
  @@index([companyId, flowRunId, seq(sort: Desc)])
  @@map("flow_run_steps")
}

model UsageEvent {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  kind     String
  quantity Int    @default(1)

  /// Cost in millionths of one unit of `currency`. 1_000_000 micros = ₹1.
  ///
  /// Micros, not minor units. Phase 11 prices AI calls below a cent each, and a
  /// paise- or cent-denominated column rounds a $0.0003 reply to zero - so a
  /// thousand conversations sum to nothing and the invoice is silently short.
  /// Micros keep every arithmetic step an integer, with rounding deferred to
  /// the one place it belongs, which is display.
  ///
  /// BigInt because Int32 tops out around 2,147 units of currency per row. A
  /// single verification costs nothing like that, but Phase 5 records ad spend,
  /// and a day of it does.
  ///
  /// NULLABLE, and unpriced events write null rather than zero. Zero is a
  /// claim that something was free; null is the absence of a claim. Summed,
  /// the two are indistinguishable, and the total renders with the same
  /// authority either way. SUM ignores nulls, so an unpriced event lowers no
  /// total - it just has to be counted separately, which the Overview does.
  costMicros BigInt? @map("cost_micros")

  /// ISO 4217, e.g. INR or USD. Comes from the matched price entry and never
  /// from the caller. Null exactly when the event is unpriced: with no entry
  /// there is no currency to claim.
  currency String?

  /// Which revision of USAGE_PRICES was in force. Stamped even when nothing
  /// matched, because "priced under version 1 and found nothing" is the fact
  /// worth keeping - it says which list to look in.
  priceVersion Int @map("price_version")

  /// Why this row has no cost. Null when it does.
  unpricedReason String? @map("unpriced_reason")

  /// What the provider said this call consumed. Null when it did not say.
  ///
  /// -----------------------------------------------------------------------
  /// Recorded now because a later phase cannot reconstruct them
  /// -----------------------------------------------------------------------
  ///
  /// Every row carries a `price_version` so it can be repriced in arrears, and
  /// per-CALL pricing can indeed be recomputed from the rows we already have.
  /// Per-TOKEN pricing cannot, and per-token is how every model provider bills.
  /// The provider's response is gone the moment the job ends; if these are not
  /// written at the call, no work in Phase 11 or afterwards can recover them.
  ///
  /// Nullable, never backfilled to zero. A Graph call has no tokens at all -
  /// whatsapp.message.sent, integration.verify and whatsapp.numbers.refresh
  /// will always be null here - and every row written before the column
  /// existed genuinely has none. Zero is the same lie `cost_micros` refuses:
  /// it claims a call consumed nothing, sums as though it were measured, and
  /// is indistinguishable from a measured zero. Null keeps "which rows do we
  /// have counts for" an answerable question, which is the first thing a
  /// repricing has to ask.
  ///
  /// -----------------------------------------------------------------------
  /// input_tokens will stop being the whole input bill
  /// -----------------------------------------------------------------------
  ///
  /// Anthropic returns `cache_creation_input_tokens` and
  /// `cache_read_input_tokens` beside `input_tokens`, and they are NOT included
  /// in it - they are a separate split of the billable input, priced above and
  /// far below the base rate respectively. Measured live in Phase 9; the shape
  /// is in 20260909100000's header and in verse-probe.mjs, which printed it.
  ///
  /// Both are zero today because nothing enables prompt caching, so these two
  /// columns are complete. The moment anything turns it on - and a system
  /// prompt carrying a knowledge base is what caching is for - this column set
  /// needs two more, with the same rule about zero. Written down rather than
  /// built, because a column nothing writes is a column nothing writes.
  inputTokens  Int? @map("input_tokens")
  outputTokens Int? @map("output_tokens")

  /// Idempotency, because DEFAULT_JOB_OPTIONS sets attempts: 5.
  ///
  /// A job that emits its usage event and then fails emits again on every
  /// retry - five rows for one provider call, in the table that becomes an
  /// invoice. Derived deterministically from the work being priced, so the
  /// retry produces the same key and the insert is a no-op.
  dedupeKey String @map("dedupe_key")

  /// When it happened, which is not always when it was written - a retried job
  /// records the original moment.
  occurredAt DateTime @db.Timestamptz(3) @default(now()) @map("occurred_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// The idempotency constraint. Scoped to the company so two tenants cannot
  /// collide on a key derived from a job id.
  @@unique([companyId, dedupeKey])
  @@index([companyId, occurredAt(sort: Desc)])
  /// The admin overview counts across every company since midnight, which the
  /// composite above cannot serve - it leads with company_id, so a query with
  /// no company predicate seq-scans the table that grows fastest.
  ///
  /// occurred_at alone, deliberately. A (kind, occurred_at) index looks more
  /// useful and is worse for this query: with kind as the leading column a
  /// range on occurred_at cannot seek, so the planner is left with a full
  /// index scan. Confirmed with EXPLAIN, which is the only reason this is not
  /// still the wrong index. A per-kind card can have its own when it exists.
  @@index([occurredAt(sort: Desc)])
  @@map("usage_events")
}

/// The tenant dashboard's numbers, recomputed on a schedule.
///
/// One row per company, which is what makes computed_at mean something: every
/// figure on the page was true at the same instant or none of them was. Split
/// across several tables a refresh could half-succeed, and the page would print
/// one "as of" line over a mixture of two moments - which is worse than being
/// stale, because it looks consistent.
///
/// Refreshed by dashboard.rollup, one repeatable job per company. Read by the
/// dashboard page and by nothing else. Everything here is derived: dropping the
/// table costs a minute of staleness and no data at all.
model DashboardRollup {
  /// The primary key IS the tenant key. See 20260905090000 on why this table
  /// carries no composite index and is exempted from that invariant by name.
  companyId String @id @map("company_id")

  /// When these figures were true. There is deliberately no updatedAt beside
  /// it: a second timestamp on a row whose entire meaning is "as of" is one
  /// that can disagree with the one being rendered.
  computedAt DateTime @db.Timestamptz(3) @map("computed_at")

  /// The platform-day boundaries the counts were taken against, so a reader can
  /// tell a fresh rollup of yesterday's day from a fresh rollup of today's.
  dayStart   DateTime @db.Timestamptz(3) @map("day_start")
  monthStart DateTime @db.Timestamptz(3) @map("month_start")

  messagesTotal    Int @default(0) @map("messages_total")
  messagesInbound  Int @default(0) @map("messages_inbound")
  messagesOutbound Int @default(0) @map("messages_outbound")

  /// The ladder, outbound only. These seven sum to messagesOutbound by a CHECK
  /// constraint, because a FILTER clause that overlaps or misses a status makes
  /// the delivery chart quietly not add up.
  outboundPending     Int @default(0) @map("outbound_pending")
  outboundUnconfirmed Int @default(0) @map("outbound_unconfirmed")
  outboundHeld        Int @default(0) @map("outbound_held")
  outboundSent        Int @default(0) @map("outbound_sent")
  outboundFailed      Int @default(0) @map("outbound_failed")
  outboundDelivered   Int @default(0) @map("outbound_delivered")
  outboundRead        Int @default(0) @map("outbound_read")

  /// Meta's error codes to counts. Grouped into headings in TypeScript, so the
  /// code lists live only in bulk/limits.ts where the send worker reads them.
  failuresByCode Json @default("{}") @map("failures_by_code")

  conversationsTotal    Int @default(0) @map("conversations_total")
  conversationsNewToday Int @default(0) @map("conversations_new_today")
  /// The reply rate's denominator and numerator: threads the business opened,
  /// and those of them the customer answered afterwards.
  conversationsMessaged Int @default(0) @map("conversations_messaged")
  conversationsReplied  Int @default(0) @map("conversations_replied")
  /// The source distribution, iterated by the chart rather than named member by
  /// member - which is where a member added later goes missing silently.
  conversationsBySource Json @default("{}") @map("conversations_by_source")

  contactsTotal    Int @default(0) @map("contacts_total")
  contactsNewToday Int @default(0) @map("contacts_new_today")

  /// Contacts by lead temperature, as {"HOT": 12, "WARM": 30}.
  ///
  /// Contacts with no score are ABSENT rather than counted under a fourth key.
  /// Unscored is not COLD, and a business whose contacts have never been
  /// through a flow would otherwise read as one whose customers are all
  /// uninterested - the same false number pending.ts exists to prevent.
  contactsByScore Json @default("{}") @map("contacts_by_score")

  /// Conversations a flow has handled at least one step of.
  ///
  /// From flow_runs, never inferred from an absent assignee. Phase 7 refused
  /// that proxy for the AI card because it counts every untouched thread as an
  /// automation success; the same objection applies here and the same answer.
  conversationsAutomated Int @default(0) @map("conversations_automated")
  /// Threads a Verse campaign stood in.
  ///
  /// Its own column rather than a wider reading of the one above, because the
  /// two are different capabilities with different remedies: a flow taking no
  /// work needs its tree looked at, a campaign taking none needs its knowledge
  /// base looked at. Collapsed, a tenant whose flow does nothing and whose
  /// campaigns do everything reads one healthy number and learns nothing.
  ///
  /// They may overlap - a thread a flow handed over and a campaign later
  /// picked up is counted by both - which is why no CHECK asserts their sum.
  conversationsVerse Int @default(0) @map("conversations_verse")

  /// Spend since monthStart, per currency, in micros held as strings. A map
  /// rather than a total because there is no exchange rate in this system;
  /// strings because jsonb numbers are doubles and cost_micros is a bigint.
  costByCurrency    Json @default("{}") @map("cost_by_currency")
  /// Events with no price. Shown when non-zero, because SUM ignores nulls and
  /// the month's spend would otherwise read as complete.
  costUnpricedCount Int  @default(0) @map("cost_unpriced_count")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("dashboard_rollups")
}

/// ---------------------------------------------------------------------------
/// Global tables below this line. Each is outside tenancy for a stated reason.
/// ---------------------------------------------------------------------------

/// Failed sign-in counter, for lockout.
///
/// GLOBAL because the username may not exist. A sign-in attempt for
/// "notauser" has no company to attribute it to, and refusing to record it
/// would make the absence of a lockout row an oracle for which usernames are
/// real.
///
/// Two row shapes share this table:
///   (username, <ip>)  5 failures  -> 15 min, exponential after
///   (username, '*')   25 failures -> 1 hour
/// The second exists because per-IP lockout is trivially defeated by the IP
/// rotation that real credential stuffing uses.
model LoginAttempt {
  id String @id @default(cuid())

  /// Which account space this counter belongs to.
  ///
  /// Part of the unique key, so a platform admin and a tenant user sharing a
  /// username do not share a lockout — otherwise attacking one locks out the
  /// other, in both directions.
  scope LoginScope @default(TENANT)

  username String
  /// A literal IP, or '*' for the per-username aggregate row.
  ip       String

  failureCount  Int       @default(0) @map("failure_count")
  /// How many times this pair has been locked out. Drives exponential backoff,
  /// and is NOT reset by a successful sign-in - only failureCount is.
  lockoutCount  Int       @default(0) @map("lockout_count")
  lockedUntil   DateTime? @db.Timestamptz(3) @map("locked_until")
  lastFailureAt DateTime @db.Timestamptz(3)  @default(now()) @map("last_failure_at")

  @@unique([scope, username, ip])
  @@index([lockedUntil])
  @@map("login_attempts")
}

enum LoginScope {
  TENANT
  ADMIN
  /// Reset-link requests, throttled per email and per address.
  PASSWORD_RESET
  /// Inbound webhook deliveries that did not resolve or did not verify.
  ///
  /// Keyed on the source address with a sentinel in `username`, the way
  /// signup throttling already is - never on the webhook key. Throttling per
  /// key would let anyone who learns a tenant's URL flood it until the key is
  /// locked out, at which point genuine Meta deliveries are refused and Meta
  /// disables the subscription. See the migration.
  WEBHOOK

  @@map("login_scope")
}

/// Platform operator. GLOBAL by design: belongs to no company.
///
/// Seeded from ADMIN_USERNAME / ADMIN_PASSWORD_HASH. Deliberately a separate
/// table rather than a role flag on User, so there is no code path where a
/// tenant session can be escalated into an admin one.
model AdminUser {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String    @map("password_hash")
  lastLoginAt  DateTime? @db.Timestamptz(3) @map("last_login_at")
  createdAt    DateTime @db.Timestamptz(3)  @default(now()) @map("created_at")
  updatedAt    DateTime @db.Timestamptz(3)  @updatedAt @map("updated_at")

  sessions AdminSession[]
  auditLogs AdminAuditLog[]
  repairRuns AdminRepairRun[]
  kycReviews KycDocument[]

  @@map("admin_users")
}

/// Admin session. Separate table AND separate cookie name from Session, so a
/// tenant cookie can never be presented as an admin one.
model AdminSession {
  id          String @id @default(cuid())
  adminUserId String @map("admin_user_id")

  tokenHash  String @unique @map("token_hash")
  csrfSecret String @map("csrf_secret")

  ipHash     String?   @map("ip_hash")
  userAgent  String?   @map("user_agent")
  createdAt  DateTime @db.Timestamptz(3)  @default(now()) @map("created_at")
  lastSeenAt DateTime @db.Timestamptz(3)  @default(now()) @map("last_seen_at")
  expiresAt  DateTime @db.Timestamptz(3)  @map("expires_at")
  revokedAt  DateTime? @db.Timestamptz(3) @map("revoked_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

/// A platform-wide maintenance run, so the panel can answer "did it finish".
///
/// Global, like the rest of the admin space: it belongs to the installation
/// rather than to any company, and the whole point is that it spans all of
/// them.
///
/// There is no progress counter. The worker cannot write here - app_runtime
/// holds no grants on the admin tables, deliberately - so completion is
/// derived instead: count the companies with a verification newer than
/// started_at. That needs no cross-role write, no new grant, and it cannot
/// drift from reality the way a counter can.
model AdminRepairRun {
  id          String  @id @default(cuid())
  adminUserId String? @map("admin_user_id")

  /// How many companies were enqueued when the run started.
  totalCompanies Int      @map("total_companies")
  startedAt      DateTime @db.Timestamptz(3) @default(now()) @map("started_at")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([startedAt(sort: Desc)])
  @@map("admin_repair_runs")
}

/// Every admin action, including reads. The admin panel can see across every
/// company, so what it looked at is itself worth recording.
model AdminAuditLog {
  id          String  @id @default(cuid())
  adminUserId String? @map("admin_user_id")

  action    String
  ip        String?
  metadata  Json?
  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_log")
}

/// Who is currently speaking for the business in a thread.
///
/// ---------------------------------------------------------------------------
/// One column, because "at most one" should be unrepresentable rather than kept
/// ---------------------------------------------------------------------------
///
/// Phase 8 shipped the two-writer bug and its fix: a flow run standing in a
/// thread while an operator types into the same thread is a conversation with
/// two authors, neither aware of the other, and only the customer able to see
/// both. That was solved for two writers by having the inbox hand off any live
/// run.
///
/// There are three now - an operator, a flow run, and Verse - and three is
/// where "whoever wrote last wins" stops being survivable. The losing writer is
/// not merely overwritten; it CARRIES ON, on its own schedule, into a
/// conversation somebody else is now having.
///
/// A single column is the whole mechanism. "At most one driver" is not a rule
/// anybody enforces; it is a thing this type cannot express the negation of.
/// Three booleans would need a CHECK to say the same, and a correct writer at
/// every site to keep it true.
///
/// NOBODY is a real member rather than NULL, so the most-read column in the
/// inbox does not put three-valued logic into every predicate. `driver IS
/// DISTINCT FROM 'VERSE'` is the kind of thing written as `!=` and got wrong
/// for exactly the rows that matter.
enum ConversationDriver {
  NOBODY
  OPERATOR
  FLOW
  VERSE

  @@map("conversation_driver")
}

enum KbSourceKind {
  FILE
  URL

  @@map("kb_source_kind")
}

/// Per document, never per base: one unreadable PDF must not make a whole
/// knowledge base look broken.
enum KbDocumentStatus {
  PENDING
  EXTRACTING
  EMBEDDING
  INDEXED
  FAILED

  @@map("kb_document_status")
}

enum VerseCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  /// Stopped by us, not by a person: Meta rejected or paused the template
  /// mid-flight. Distinct from PAUSED because nobody chose it and resuming will
  /// not fix it - see stoppedReason.
  STOPPED
  ARCHIVED

  @@map("verse_campaign_status")
}

enum VerseRecipientStatus {
  PENDING
  SENT
  SKIPPED
  FAILED

  @@map("verse_recipient_status")
}

/// One tenant's uploaded knowledge, and the model its vectors came from.
model KnowledgeBase {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  name      String

  /// The pin, stamped per index.
  ///
  /// Denormalised from VERSE_EMBEDDING deliberately. The constant says what NEW
  /// work uses; this says what the vectors in this base actually came from, and
  /// during a re-embedding migration those two disagree for as long as it runs.
  /// A retrieval that cannot tell the difference is one that mixes models.
  embeddingModel   String @map("embedding_model")
  embeddingVersion Int    @map("embedding_version")

  createdAt DateTime  @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime  @db.Timestamptz(3) @updatedAt @map("updated_at")
  /// Archived, never deleted. A campaign that ran against this base is a record
  /// of what customers were told, and these passages are the only evidence of
  /// why the answers said what they said.
  archivedAt DateTime? @db.Timestamptz(3) @map("archived_at")

  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documents KbDocument[]
  chunks    KbChunk[]
  campaigns VerseCampaign[]

  @@index([companyId, createdAt(sort: Desc)])
  @@map("knowledge_bases")
}

/// One uploaded file or crawled page, and how far through the pipeline it got.
model KbDocument {
  id              String @id @default(cuid())
  companyId       String @map("company_id")
  knowledgeBaseId String @map("knowledge_base_id")

  kind      KbSourceKind
  title     String
  sourceUrl String?      @map("source_url")
  filename  String?
  mimeType  String?      @map("mime_type")
  byteSize  Int?         @map("byte_size")

  status KbDocumentStatus @default(PENDING)

  /// Why it failed, in words an operator can act on.
  ///
  /// Not a boolean and not a code. The realistic failures are "this PDF is a
  /// scan with no text layer", "the server returned 403" and "robots.txt
  /// disallows this path", and each has a remedy the tenant can carry out. A
  /// red dot saying FAILED sends them to support for something they could have
  /// fixed in a minute. A CHECK ties this to the status.
  failureReason String? @map("failure_reason")

  /// The uploaded file. Null for a URL document.
  ///
  /// Stored so extraction can happen in the worker: a 300-page PDF takes
  /// seconds to parse, and a server action holding a pooled connection for
  /// that long is a request nobody waits out. Same arrangement as
  /// whatsapp_media.bytes and kyc_documents.bytes, including STORAGE EXTERNAL.
  ///
  /// Never selected by a list query. Every read of this column is the
  /// ingestion handler asking for one document by id.
  bytes Bytes?

  chunkCount Int       @default(0) @map("chunk_count")
  indexedAt  DateTime? @db.Timestamptz(3) @map("indexed_at")

  /// sha256 of the extracted TEXT, not of the bytes.
  ///
  /// A PDF's bytes change when its producer re-saves it and the words do not.
  /// Re-embedding two thousand chunks because Acrobat rewrote a timestamp is a
  /// real bill, and text is what the index is actually made of.
  contentHash String? @map("content_hash")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunkSources  KbChunkSource[]

  @@index([companyId, knowledgeBaseId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@map("kb_documents")
}

/// One retrievable passage, and its vector. Deduplicated by content.
///
/// ---------------------------------------------------------------------------
/// One passage, many sources
/// ---------------------------------------------------------------------------
///
/// Identical text is one chunk that several documents point at, not several
/// chunks. That is not tidiness: retrieval is `LIMIT k`, so k duplicates of one
/// paragraph is a top-k holding ONE passage while the code, the /dev/rag
/// harness and the operator all believe it holds k. Grounding is thinner than
/// it looks and nothing says so.
///
/// Identical text is ordinary in a knowledge base - a boilerplate paragraph
/// repeated across documents, the same page crawled under two URLs, a PDF and
/// its web version both uploaded, a terms section quoted in a FAQ.
///
/// So `document_id` and `seq` live on KbChunkSource, one row per place the text
/// appears, and this table is keyed by content within a base.
model KbChunk {
  id              String @id @default(cuid())
  companyId       String @map("company_id")
  knowledgeBaseId String @map("knowledge_base_id")

  /// SHA-256 of `content`, hex, and the deduplication key.
  ///
  /// Exact bytes, never normalised. Collapsing on whitespace or case would
  /// merge passages that are not the same text, which is a claim about meaning
  /// this column has no business making - and it is unrecoverable, because the
  /// discarded variant is gone. Two passages differing by one space stay two
  /// chunks; that is the safe direction to be wrong in.
  contentHash String @map("content_hash")

  content    String
  tokenCount Int @map("token_count")

  /// The embedding.
  ///
  /// ---------------------------------------------------------------------
  /// Unsupported, which is why packages/db/src/verse.ts holds raw SQL
  /// ---------------------------------------------------------------------
  ///
  /// Prisma has no vector type, so this column cannot be selected, inserted or
  /// compared through the query builder at all - `Unsupported` fields are
  /// omitted from every generated type. Retrieval is a `<=>` operator against
  /// a bound vector with an ORDER BY and a LIMIT, which has no query-builder
  /// form even in principle.
  ///
  /// So `verse.ts` is the tenth entry in no-raw-sql.test.ts, and the narrowest
  /// justification of the ten: not "this is faster" but "this is the only way
  /// to read this column".
  ///
  /// The width is the pin, in DDL. See the migration header - changing it is a
  /// re-embedding migration and never an ALTER, because every stored vector is
  /// wrong the instant the model changes.
  embedding Unsupported("vector(1536)")

  /// Which model produced THIS vector.
  ///
  /// Redundant with the knowledge base's column on every correct row, and that
  /// is the point: during a re-embedding migration it is the only way to tell a
  /// converted row from an unconverted one. A mixed index is otherwise
  /// invisible, and verse-embedding-pin.test.ts asserts no base holds two.
  embeddingModel   String @map("embedding_model")
  embeddingVersion Int    @map("embedding_version")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  sources       KbChunkSource[]

  /// The deduplication key, and it is per knowledge base rather than per
  /// company on purpose: two bases are two indexes, and one may be re-embedded
  /// while the other is not. Sharing a row across them would make a vector
  /// belong to two pins at once.
  @@unique([companyId, knowledgeBaseId, contentHash])
  @@index([companyId, knowledgeBaseId])
  @@map("kb_chunks")
}

/// Where a chunk's text appears: one row per (document, position).
///
/// The many half of the many-to-one. A chunk with two sources is one passage
/// that two documents contain, and BOTH are cited - which is the reason this is
/// a relation rather than a discarded duplicate. An answer that says "From
/// Terms" when the sentence is also in the FAQ has not lied, but it has told
/// the operator less than we knew.
///
/// Deleting a document cascades these away and leaves the chunk behind if
/// another document still points at it. A chunk whose last source is gone is
/// deleted explicitly - see deleteDocumentAndOrphanedChunks. Nothing about a
/// foreign key can express "delete the parent when its last child goes", and
/// getting that wrong leaves a passage answering customers from a document the
/// tenant believes they deleted.
model KbChunkSource {
  id         String @id @default(cuid())
  companyId  String @map("company_id")
  chunkId    String @map("chunk_id")
  documentId String @map("document_id")

  /// Position in THIS document, so a retrieved passage can be shown in context
  /// and two adjacent hits can be recognised as adjacent. It moves here from
  /// kb_chunks because one passage can sit at position 3 of one document and
  /// position 40 of another.
  seq Int

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chunk    KbChunk    @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  document KbDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// One passage per position in a document - the same key kb_chunks used to
  /// carry, moved to the table where it is now true.
  @@unique([companyId, documentId, seq])
  @@index([companyId, chunkId])
  @@map("kb_chunk_sources")
}

/// One AI campaign: what it is for, what opens it, and when it may speak.
model VerseCampaign {
  id        String @id @default(cuid())
  companyId String @map("company_id")
  name      String

  /// The tenant's own words, verbatim into the system prompt.
  ///
  /// Stored as written and never normalised, summarised or reformatted. This is
  /// the one part of the prompt the tenant authored, and editing it on their
  /// behalf - even to fix spelling - changes what the model was asked to do in
  /// a way nothing in the UI would show.
  goal String

  /// What opens the conversation. An approved template, because nothing else
  /// may be sent before a 24-hour window exists.
  templateId String @map("template_id")
  /// 'V1' | 'V2' | 'V3'. Text rather than an enum, because the tiers are
  /// defined in packages/core/src/verse/models.ts and a Prisma enum here could
  /// only ever disagree with it - the argument usage_events.kind already makes.
  modelTier       String @map("model_tier")
  knowledgeBaseId String @map("knowledge_base_id")

  /// Which number this campaign sends from.
  ///
  /// Not derived from the template: a template belongs to an integration and
  /// an integration can hold several numbers, so "the template's number" would
  /// be a silent pick among them - and a business running one number for
  /// support and another for marketing would find a campaign going out from
  /// whichever sorted first.
  ///
  /// Nullable because a DRAFT is built field by field in the wizard. A CHECK,
  /// not NOT NULL, is what stops a RUNNING campaign without one.
  whatsappNumberId String? @map("whatsapp_number_id")

  status        VerseCampaignStatus @default(DRAFT)
  /// Why we stopped it. Tied to STOPPED by a CHECK.
  stoppedReason String?             @map("stopped_reason")

  /// An IANA name, never an offset. An offset is wrong twice a year, and what
  /// that produces is messaging people an hour either side of a window whose
  /// entire purpose is that nobody is messaged at 2am.
  timezone String
  startAt  DateTime? @db.Timestamptz(3) @map("start_at")

  /// Minutes past local midnight, or null for no daily window.
  ///
  /// Minutes rather than a `time` column because the comparison happens in
  /// JavaScript against a tenant-local wall clock derived from the timezone
  /// above. A `time` column invites comparing it in SQL against a server clock
  /// that is in UTC, which is the bug this shape exists to make awkward.
  dailyWindowStartMinute Int? @map("daily_window_start_minute")
  dailyWindowEndMinute   Int? @map("daily_window_end_minute")
  /// Most messages per calendar day in the tenant's timezone. Null = no cap.
  dailyCap Int? @map("daily_cap")

  archivedAt DateTime? @db.Timestamptz(3) @map("archived_at")
  createdAt  DateTime  @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt  DateTime  @db.Timestamptz(3) @updatedAt @map("updated_at")

  company       Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  template      WhatsAppTemplate         @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// Restrict, not Cascade. Deleting a knowledge base out from under a running
  /// campaign leaves it retrieving from nothing and answering from the model's
  /// general knowledge - the exact failure this phase exists to prevent.
  knowledgeBase KnowledgeBase            @relation(fields: [knowledgeBaseId], references: [id], onDelete: Restrict)
  /// Restrict: a campaign whose number was deleted must not silently become
  /// one that sends from nowhere. The delete is refused instead.
  whatsappNumber WhatsAppNumber?         @relation(fields: [whatsappNumberId], references: [id], onDelete: Restrict)
  recipients    VerseCampaignRecipient[]
  leadSources   LeadSource[]

  @@index([companyId, createdAt(sort: Desc)])
  @@index([companyId, status])
  @@index([companyId, whatsappNumberId])
  @@map("verse_campaigns")
}

/// One person a campaign intends to contact, before and after it does.
///
/// A draft audience is not message rows, for the reason Phase 5 gives about
/// broadcast_recipients: putting un-sent intent into `messages` would need a
/// pre-send member on message_status, describing rows that are not messages
/// yet, in the one enum every delivery callback already reasons about.
model VerseCampaignRecipient {
  id         String @id @default(cuid())
  companyId  String @map("company_id")
  campaignId String @map("campaign_id")

  contactId String? @map("contact_id")
  phoneE164 String  @map("phone_e164")
  /// The template's parameters, in Meta's positional order.
  variables Json    @default("[]")

  status     VerseRecipientStatus @default(PENDING)
  /// Why this one was not sent. Tied to SKIPPED by a CHECK.
  skipReason String?              @map("skip_reason")

  /// Where the audience became an ordinary message, exactly as bulk does it.
  messageId      String? @map("message_id")
  conversationId String? @map("conversation_id")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign     VerseCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  /// One row per person per campaign.
  ///
  /// The same argument as the lead-source idempotency index: a check-then-insert
  /// loses to a retrying job, and what comes out of that race is a real
  /// customer messaged twice by the same campaign.
  @@unique([companyId, campaignId, phoneE164])
  @@index([companyId, campaignId, status])
  @@map("verse_campaign_recipients")
}


/// Meta's campaign lifecycle, as far as this product drives it.
///
/// PAUSED is the default and the safety property of the whole phase. A
/// campaign created ACTIVE spends the tenant's money the instant a form posts,
/// with a budget somebody typed while still thinking about it, and there is no
/// undo for money Meta has already spent.
enum MetaCampaignStatus {
  PAUSED
  ACTIVE
  ARCHIVED

  @@map("meta_campaign_status")
}

/// Meta's outcome-era objectives, which are the only ones their current API
/// accepts on create. The older names (LINK_CLICKS, CONVERSIONS) are rejected,
/// so offering them would be a builder that composes a campaign Meta refuses.
enum MetaCampaignObjective {
  OUTCOME_ENGAGEMENT
  OUTCOME_LEADS
  OUTCOME_TRAFFIC
  OUTCOME_SALES

  @@map("meta_campaign_objective")
}

/// An ad account the tenant selected, under their own Meta credentials.
///
/// A3: the credentials are theirs, stored per-tenant in the integrations
/// section, and this app never holds one that reaches across tenants.
model MetaAdAccount {
  id            String @id @default(cuid())
  companyId     String @map("company_id")
  integrationId String @map("integration_id")

  /// Meta's own identifier, stored WITH its act_ prefix, because that is the
  /// form every Graph path takes and normalising on the way out is one more
  /// place to forget.
  metaAdAccountId String @map("meta_ad_account_id")
  name            String

  /// The account's own currency, and the reason spend is never summed across
  /// accounts. There is no exchange rate in this system and one must not
  /// appear at render time.
  currency      String
  timezoneName  String? @map("timezone_name")
  accountStatus Int?    @map("account_status")

  /// The Page a click-to-WhatsApp ad posts from. A CTWA ad cannot exist
  /// without one, and the Page is what carries the WhatsApp number.
  pageId   String? @map("page_id")
  pageName String? @map("page_name")

  /// The number Meta says that Page is linked to, as our row. Null when the
  /// link points somewhere we do not own - an agency running ads for a
  /// business whose WhatsApp lives elsewhere, which is real and common.
  whatsappNumberId String? @map("whatsapp_number_id")
  /// What Meta reported, verbatim, even when it matches nothing here. Without
  /// it the mismatch is unexplainable: the page can say the Page is linked to
  /// a different number but not which.
  linkedPhoneE164 String? @map("linked_phone_e164")

  /// How far the insights sync has read, as a date in the account's own
  /// timezone. Null means it has never run.
  insightsSyncedThrough DateTime? @db.Date @map("insights_synced_through")
  insightsSyncedAt      DateTime? @db.Timestamptz(3) @map("insights_synced_at")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  integration    Integration     @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  whatsappNumber WhatsAppNumber? @relation(fields: [whatsappNumberId], references: [id], onDelete: SetNull)
  campaigns      MetaCampaign[]
  insights       MetaAdInsight[]

  @@unique([companyId, metaAdAccountId], map: "meta_ad_accounts_company_id_meta_ad_account_id_key")
  @@index([companyId, createdAt(sort: Desc)], map: "meta_ad_accounts_company_id_created_at_idx")
  @@index([companyId, integrationId], map: "meta_ad_accounts_company_id_integration_id_idx")
  @@map("meta_ad_accounts")
}

/// A campaign this product created at Meta.
///
/// A row here means a campaign EXISTS at Meta. There is deliberately no local
/// draft state: that would be a second lifecycle to reason about, and the
/// thing a tenant wants to keep half-finished is the form, which is not a
/// database concern.
model MetaCampaign {
  id          String @id @default(cuid())
  companyId   String @map("company_id")
  adAccountId String @map("ad_account_id")

  metaCampaignId String                @map("meta_campaign_id")
  name           String
  objective      MetaCampaignObjective
  status         MetaCampaignStatus    @default(PAUSED)

  /// Millionths of one unit of this row's currency, matching usage events.
  /// Meta takes minor units; the conversion happens at the boundary so that
  /// nothing here is denominated in paise for one row and rupees for another.
  dailyBudgetMicros BigInt? @map("daily_budget_micros")
  /// Copied from the ad account at creation rather than joined at read time.
  /// Every reader of this table is forbidden from adding two currencies
  /// together, so each row has to carry its own.
  currency String

  /// When somebody deliberately turned it on, and who. Stays set once set:
  /// pausing a live campaign does not un-publish it, and "has this ever run"
  /// must not be answered by the current state.
  publishedAt       DateTime? @db.Timestamptz(3) @map("published_at")
  publishedByUserId String?   @map("published_by_user_id")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adAccount   MetaAdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)
  publishedBy User?         @relation("MetaCampaignsPublished", fields: [publishedByUserId], references: [id], onDelete: SetNull)

  @@unique([companyId, metaCampaignId], map: "meta_campaigns_company_id_meta_campaign_id_key")
  @@index([companyId, createdAt(sort: Desc)], map: "meta_campaigns_company_id_created_at_idx")
  @@index([companyId, adAccountId], map: "meta_campaigns_company_id_ad_account_id_idx")
  @@map("meta_campaigns")
}

/// What Meta says a campaign spent, per day.
///
/// The day is Meta's, in the ad account's timezone. An account set to
/// America/Los_Angeles has a different Tuesday from a platform day computed at
/// +05:30, and re-syncing under our own boundary would move spend between days
/// on every run.
model MetaAdInsight {
  id          String @id @default(cuid())
  companyId   String @map("company_id")
  adAccountId String @map("ad_account_id")

  /// Meta's campaign id as text, NOT a relation to MetaCampaign.
  ///
  /// A tenant's account contains campaigns they built in Meta's own tools long
  /// before connecting here, and those spend money that belongs in "cost this
  /// month". A foreign key would force us to drop that spend or to invent
  /// MetaCampaign rows for campaigns this product did not create - and a row
  /// there means "we made this", which would stop being true.
  metaCampaignId String  @map("meta_campaign_id")
  campaignName   String? @map("campaign_name")

  /// The advertising day. A date and not a timestamp: Meta reports a day, and
  /// storing midnight in some zone invites somebody to render it as an instant.
  date DateTime @db.Date

  impressions BigInt @default(0)
  clicks      BigInt @default(0)

  /// Millionths of one unit of this row's currency. BigInt because the value
  /// must never pass through a JSON number - past 2^53 it silently drops its
  /// last digits, which is the worst possible way to discover a column's type.
  spendMicros BigInt @default(0) @map("spend_micros")
  currency    String

  syncedAt DateTime @db.Timestamptz(3) @default(now()) @map("synced_at")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")
  updatedAt DateTime @db.Timestamptz(3) @updatedAt @map("updated_at")

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adAccount MetaAdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  /// What makes the sync idempotent. Meta restates recent days as attribution
  /// windows close, so a re-read must UPDATE the day rather than add a second
  /// copy - without this a nightly sync over a 28-day window multiplies every
  /// figure by 28.
  @@unique([companyId, adAccountId, metaCampaignId, date], map: "meta_ad_insights_company_id_ad_account_id_meta_campaig_date_key")
  @@index([companyId, date(sort: Desc)], map: "meta_ad_insights_company_id_date_idx")
  @@map("meta_ad_insights")
}

/// The click that started a conversation.
///
/// Meta attaches a referral block to the FIRST inbound message of a thread
/// that began with a click-to-WhatsApp ad. It arrives exactly once. A webhook
/// that reads it and drops it has lost the only join between money spent and a
/// person who replied - permanently, because Meta's Insights API reports spend
/// per ad and has no idea which WhatsApp thread it produced.
///
/// Its own table rather than columns on Conversation, for the reason
/// WhatsAppConversationCharge gives about billing windows: one contact can
/// click three different ads in a month, and columns would keep the newest and
/// lose the two that actually converted.
model MetaAdReferral {
  id        String @id @default(cuid())
  companyId String @map("company_id")

  conversationId String @map("conversation_id")
  contactId      String @map("contact_id")
  /// The inbound message that carried the block, and the dedupe key: Meta
  /// redelivers a webhook it did not get a 200 for.
  messageId String @map("message_id")

  /// Meta's click id, which their attribution reporting is keyed on.
  ctwaClid String? @map("ctwa_clid")
  /// The ad id. This is what joins a conversation to spend.
  sourceId String? @map("source_id")
  /// "ad" or "post", verbatim. An organic post referral is not an ad click and
  /// must not be counted as one in a cost-per-lead figure.
  sourceType String? @map("source_type")
  sourceUrl  String? @map("source_url")

  /// The ad's own copy, as Meta sent it. What makes a referral legible six
  /// weeks later, when the ad has been edited or deleted and Meta will no
  /// longer say what it said.
  headline String?
  body     String?

  /// Meta's instant, never ours.
  occurredAt DateTime @db.Timestamptz(3) @map("occurred_at")

  createdAt DateTime @db.Timestamptz(3) @default(now()) @map("created_at")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([companyId, messageId], map: "meta_ad_referrals_company_id_message_id_key")
  @@index([companyId, sourceId], map: "meta_ad_referrals_company_id_source_id_idx")
  @@index([companyId, occurredAt(sort: Desc)], map: "meta_ad_referrals_company_id_occurred_at_idx")
  @@map("meta_ad_referrals")
}